{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "paths": {
      "@src/*": [
        "./src/*"
      ],
      "@tiebreak/*": [
        "./node_modules/@tiebreak-websites/astro-wp/src/*"
      ],
    },
  }
}