---
import "../styles/global.css";
import "../styles/nxreg.css";
import "../styles/iti.css";
import "../styles/loader.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LegalData from "@tiebreak/components/base/LegalData.astro";
import Scripts from "../components/Scripts.astro";

const {
  title = "Vectora — AI Trading Algos",
  description = "Your guardian layer for clearer market decisions. Vectora watches selected market conditions, checks risk around each setup, and helps you see the trade more clearly before you commit.",
  isRegister = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0F0D" />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og-image.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <LegalData />
    <Scripts isRegister={isRegister} />
  </head>
  <body>
    <a href="#main" class="sr-only">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // ---- Scroll reveal (re-wired on every page swap) ----
      const initReveals = () => {
        const reveals = document.querySelectorAll(".reveal:not(.is-visible)");
        if (!reveals.length) return;
        if ("IntersectionObserver" in window) {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
          );
          reveals.forEach((el) => io.observe(el));
        } else {
          reveals.forEach((el) => el.classList.add("is-visible"));
        }
      };

      // ---- Count-up stats ----
      const initCounters = () => {
        const counters = document.querySelectorAll<HTMLElement>(
          "[data-count]:not([data-counted])",
        );
        if (!counters.length || !("IntersectionObserver" in window)) return;
        const formatNum = (n: number, decimals: number) =>
          n.toLocaleString("en-US", {
            minimumFractionDigits: decimals,
            maximumFractionDigits: decimals,
          });
        const run = (el: HTMLElement) => {
          const target = parseFloat(el.dataset.count || "0");
          const decimals = parseInt(el.dataset.decimals || "0", 10);
          const prefix = el.dataset.prefix || "";
          const suffix = el.dataset.suffix || "";
          const dur = 1600;
          let start: number | null = null;
          const step = (t: number) => {
            if (start === null) start = t;
            const p = Math.min((t - start) / dur, 1);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent =
              prefix + formatNum(target * eased, decimals) + suffix;
            if (p < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        };
        const cio = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                run(entry.target as HTMLElement);
                cio.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.5 },
        );
        counters.forEach((el) => {
          el.dataset.counted = "true";
          cio.observe(el);
        });
      };

      const boot = () => {
        initReveals();
        initCounters();
      };
      boot();
      document.addEventListener("astro:after-swap", boot);

      // ---- Spotlight cards: cursor-following glow (delegated, wired once) ----
      document.addEventListener(
        "mousemove",
        (e) => {
          const target = e.target as Element | null;
          const spot = target?.closest?.(".spot") as HTMLElement | null;
          if (!spot) return;
          const r = spot.getBoundingClientRect();
          spot.style.setProperty("--mx", `${e.clientX - r.left}px`);
          spot.style.setProperty("--my", `${e.clientY - r.top}px`);
        },
        { passive: true },
      );
    </script>
  </body>
</html>
