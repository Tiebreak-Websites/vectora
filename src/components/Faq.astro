---
const { section } = Astro.props;
// FAQ — answers assembled from the official Guardian Bots site copy.
const faqs = [
  {
    q: "What exactly does Vectora do?",
    a: "Vectora runs automated trading algos that watch selected market conditions, check risk around each setup, and execute their strategy automatically. You choose the package and algo selection — once activated, the algo operates independently within its rules.",
  },
  {
    q: "Which instruments do the algos cover?",
    a: "Vectora currently offers concrete algo packages for Gold, Bitcoin, and the Nasdaq index through technically compatible broker platforms — MIRA for Gold, AXON for BTC, and KAIRO for Nasdaq. More instruments are coming soon.",
  },
  {
    q: "How do I get started?",
    a: "From sign-up to self-service algo setup in three clear steps: open an account with a technically compatible broker platform, set your package, algo selection, and risk preferences, and activate. Our team provides technical setup assistance — not investment advice or package selection guidance.",
  },
  {
    q: "Is there a refund period?",
    a: "Yes — every package comes with a 60-day refund period. If the algo has been used during that period, the refund may be reduced proportionally to usage. All refunds are handled under our Terms of Service.",
  },
  {
    q: "How long do I have access to the algos?",
    a: "Every package includes 1 year of algo access from the date of purchase.",
  },
  {
    q: "How much does a package cost?",
    a: "Foundation is $3,000 and unlocks any one algo of your choice. Advanced is $5,000 and lets you combine any two algos. Elite is $7,000 and includes all three algos. Every package comes with a 60-day refund period and 1 year of algo access. Foundation is available now; Advanced and Elite are coming soon and will be activated through technically compatible broker platforms.",
  },
  {
    q: "Is there a minimum margin requirement?",
    a: "Yes. Each package has a minimum margin the algos need in your trading account to operate: $5,000 for Foundation, $10,000 for Advanced, and $15,000 for Elite. This is working margin in your own account — not a fee paid to Vectora.",
  },
  {
    q: "Are the ROI figures guaranteed?",
    a: 'No. ROI figures are approximate "up to" values based on historical, backtested, or tracked performance. Past performance is not indicative of future results. Trading involves risk and can result in loss of capital.',
  },
];
---

<section class="section faq" id="faq">
  <div class="container">
    <div class="section-head reveal">
      <h2>{section.headline}</h2>
    </div>

    <div class="faq-list">
      {
        section.items.map((f, i) => (
          <details class="faq-item reveal" style={`--reveal-delay:${i * 60}ms`}>
            <summary>
              <span class="fq">{f.q}</span>
              <span class="ficon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </span>
            </summary>
            <div class="fa-wrap">
              <p class="fa">{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-list {
    max-width: 780px;
    margin-inline: auto;
    border-top: 1px solid var(--line);
  }
  .faq-item {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.25rem 0.25rem;
    cursor: pointer;
    list-style: none;
    transition: color 0.2s ease;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .fq {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.06rem;
    color: var(--text);
    transition: color 0.2s ease;
  }
  summary:hover .fq {
    color: var(--green-bright);
  }
  .ficon {
    flex: none;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    color: var(--text-3);
    transition:
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }
  .ficon svg {
    width: 15px;
    height: 15px;
  }
  .faq-item[open] .ficon {
    transform: rotate(45deg);
    color: var(--green-bright);
    border-color: rgba(23, 212, 139, 0.4);
    background: var(--green-tint);
  }

  .fa-wrap {
    overflow: hidden;
  }
  .fa {
    color: var(--text-3);
    font-size: 0.96rem;
    padding: 0 0.25rem 1.4rem;
    max-width: 68ch;
  }
  .faq-item[open] .fa {
    animation: faqIn 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes faqIn {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .fa {
      animation: none;
    }
  }
</style>
