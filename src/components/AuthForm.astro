---
import Logo from './Logo.astro';

const { mode = 'login' } = Astro.props;
const isLogin = mode === 'login';

const perks = [
  'Three specialist algos — gold, Bitcoin, Nasdaq',
  'Every trade visible in your own account',
  '60-day refund period',
  '1 year of algo access with every package',
];

// Dial codes for the sign-up phone field. Compact "+359 BG" labels keep the
// closed select as narrow as the reference while staying scannable when open.
// Bulgaria is the default; the rest are the markets clients sign up from.
const dialCodes = [
  { code: '+359', iso: 'BG' },
  { code: '+43', iso: 'AT' },
  { code: '+32', iso: 'BE' },
  { code: '+357', iso: 'CY' },
  { code: '+420', iso: 'CZ' },
  { code: '+45', iso: 'DK' },
  { code: '+358', iso: 'FI' },
  { code: '+33', iso: 'FR' },
  { code: '+49', iso: 'DE' },
  { code: '+30', iso: 'GR' },
  { code: '+36', iso: 'HU' },
  { code: '+353', iso: 'IE' },
  { code: '+972', iso: 'IL' },
  { code: '+39', iso: 'IT' },
  { code: '+352', iso: 'LU' },
  { code: '+356', iso: 'MT' },
  { code: '+31', iso: 'NL' },
  { code: '+47', iso: 'NO' },
  { code: '+48', iso: 'PL' },
  { code: '+351', iso: 'PT' },
  { code: '+40', iso: 'RO' },
  { code: '+34', iso: 'ES' },
  { code: '+46', iso: 'SE' },
  { code: '+41', iso: 'CH' },
  { code: '+90', iso: 'TR' },
  { code: '+971', iso: 'AE' },
  { code: '+44', iso: 'GB' },
  { code: '+1', iso: 'US' },
  { code: '+61', iso: 'AU' },
  { code: '+852', iso: 'HK' },
  { code: '+91', iso: 'IN' },
  { code: '+81', iso: 'JP' },
  { code: '+965', iso: 'KW' },
  { code: '+968', iso: 'OM' },
  { code: '+974', iso: 'QA' },
  { code: '+966', iso: 'SA' },
  { code: '+65', iso: 'SG' },
  { code: '+27', iso: 'ZA' },
  { code: '+82', iso: 'KR' },
];

const socialVerb = isLogin ? 'Continue' : 'Sign up';
---

<section class="auth">
  <div class="container auth-wrap">
    <div class="auth-shell grad-border reveal">
      <aside class="auth-side" aria-hidden="true">
        <a href="/" class="side-logo" aria-label="Vectora home"><Logo height={30} /></a>
        <h2>Trading discipline,<br /><span class="grad-text">automated.</span></h2>
        <ul class="side-perks">
          {perks.map((p) => (
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>{p}</li>
          ))}
        </ul>
        <div class="side-stats">
          <div><span class="ss-v">92%*</span><span class="ss-k">Win rate</span></div>
          <div><span class="ss-v">1–2%*</span><span class="ss-k">Drawdown</span></div>
          <div><span class="ss-v">24/7</span><span class="ss-k">Execution</span></div>
        </div>
      </aside>

      <div class="auth-main">
        <h1>{isLogin ? 'Log in' : 'Sign up'}</h1>
        <p class="switch">
          {isLogin
            ? <span>Don't have an account? <a href="/signup">Sign up</a></span>
            : <span>Already have an account? <a href="/login">Log in</a></span>}
        </p>

        <div class="social">
          <button type="button" class="soc" data-provider="Google">
            <span class="soc-icon" aria-hidden="true">
              <svg viewBox="0 0 48 48">
                <path fill="#FFC107" d="M43.61 20.08H42V20H24v8h11.3c-1.65 4.66-6.08 8-11.3 8-6.63 0-12-5.37-12-12s5.37-12 12-12c3.06 0 5.84 1.15 7.96 3.04l5.66-5.66C34.05 6.05 29.27 4 24 4 12.95 4 4 12.95 4 24s8.95 20 20 20 20-8.95 20-20c0-1.34-.14-2.65-.39-3.92z"/>
                <path fill="#FF3D00" d="M6.31 14.69l6.57 4.82C14.66 15.11 18.96 12 24 12c3.06 0 5.84 1.15 7.96 3.04l5.66-5.66C34.05 6.05 29.27 4 24 4 16.32 4 9.66 8.34 6.31 14.69z"/>
                <path fill="#4CAF50" d="M24 44c5.17 0 9.86-1.98 13.41-5.19l-6.19-5.24A11.9 11.9 0 0 1 24 36c-5.2 0-9.62-3.32-11.28-7.95l-6.52 5.03C9.51 39.56 16.23 44 24 44z"/>
                <path fill="#1976D2" d="M43.61 20.08H42V20H24v8h11.3a12.04 12.04 0 0 1-4.09 5.57l6.19 5.24C36.97 39.21 44 34 44 24c0-1.34-.14-2.65-.39-3.92z"/>
              </svg>
            </span>
            <span class="soc-label">{socialVerb} with Google</span>
          </button>

          <button type="button" class="soc" data-provider="Facebook">
            <span class="soc-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="12" fill="#1877F2"/>
                <path fill="#fff" d="M16.5 15.5l.55-3.6h-3.45V9.55c0-.98.48-1.94 2.03-1.94h1.57V4.55s-1.43-.25-2.8-.25c-2.86 0-4.73 1.73-4.73 4.87v2.73H6.5v3.6h3.17V24a12.1 12.1 0 0 0 3.7 0v-8.5h3.13z"/>
              </svg>
            </span>
            <span class="soc-label">{socialVerb} with Facebook</span>
          </button>
        </div>

        <form id="auth-form" class="auth-form" novalidate data-mode={mode}>
          {!isLogin && (
            <div class="field">
              <label for="name" class="sr-only">Full name</label>
              <input id="name" name="name" type="text" autocomplete="name" placeholder="Full name" required />
              <span class="err" data-for="name"></span>
            </div>
          )}

          {isLogin ? (
            <div class="field">
              <label for="username">Username</label>
              <input id="username" name="username" type="text" autocomplete="username" required />
              <span class="err" data-for="username"></span>
            </div>
          ) : (
            <div class="field">
              <label for="email" class="sr-only">Email</label>
              <input id="email" name="email" type="email" autocomplete="email" placeholder="Email" required />
              <span class="err" data-for="email"></span>
            </div>
          )}

          {!isLogin && (
            <div class="field">
              <label for="phone" class="sr-only">Phone number</label>
              <div class="phone-row">
                <select id="dial" name="dial" class="dial" aria-label="Country dial code">
                  {dialCodes.map((d) => (
                    <option value={d.code} selected={d.code === '+359'}>{d.code} {d.iso}</option>
                  ))}
                </select>
                <input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="Phone number" required />
              </div>
              <span class="err" data-for="phone"></span>
            </div>
          )}

          <div class="field">
            <label for="password" class={isLogin ? '' : 'sr-only'}>Password</label>
            <div class="pw-row">
              <input
                id="password"
                name="password"
                type="password"
                autocomplete={isLogin ? 'current-password' : 'new-password'}
                placeholder={isLogin ? '' : 'Password (8+ characters)'}
                required
              />
              {isLogin && (
                <button type="button" class="pw-toggle" aria-label="Show password" aria-pressed="false">
                  <svg class="eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 2l20 20"/><path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"/><path d="M9.4 5.2A9.8 9.8 0 0 1 12 5c5.5 0 9 5.5 9 7a12 12 0 0 1-2.3 3.2M6.2 6.7C3.9 8.2 3 10.4 3 12c0 1.5 3.5 7 9 7 1.4 0 2.7-.35 3.8-.9"/></svg>
                  <svg class="eye-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12s3.5-7 9-7 9 5.5 9 7-3.5 7-9 7-9-5.5-9-7z"/><circle cx="12" cy="12" r="2.6"/></svg>
                </button>
              )}
            </div>
            <span class="err" data-for="password"></span>
          </div>

          {isLogin ? (
            <div class="login-opts">
              <label class="check"><input type="checkbox" name="remember" /> Remember me</label>
              <a href="#" class="link-sm">Forgot password?</a>
            </div>
          ) : (
            <label class="check terms">
              <input type="checkbox" name="terms" required />
              <span>By clicking Create an Account I agree with the <a href="#">Terms of Service</a>, <a href="#">Privacy Policy</a> &amp; <a href="#">Risk Disclosure</a>.</span>
            </label>
          )}

          <button type="submit" class="btn btn-primary btn-lg auth-submit">{isLogin ? 'Log in' : 'Create an Account'}</button>
          <p class="form-status" id="auth-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .auth {
    min-height: calc(100vh - var(--header-h));
    display: grid;
    align-items: center;
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }
  .auth-wrap { display: grid; justify-items: center; }
  .auth-shell {
    width: 100%;
    max-width: 920px;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow), 0 0 80px -30px var(--green-glow);
  }

  /* Brand side */
  .auth-side {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    background:
      radial-gradient(34rem 24rem at -10% -10%, rgba(9, 161, 101, 0.22), transparent 60%),
      radial-gradient(30rem 22rem at 110% 110%, rgba(9, 161, 101, 0.14), transparent 60%),
      var(--bg-2);
    border-right: 1px solid var(--line);
  }
  .side-logo { display: inline-flex; }
  .auth-side h2 {
    font-size: clamp(1.6rem, 2.8vw, 2.1rem);
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
  }
  .side-perks { margin-top: 1.5rem; display: grid; gap: 0.7rem; }
  .side-perks li { display: flex; gap: 0.6rem; align-items: flex-start; color: var(--text-2); font-size: 0.92rem; }
  .side-perks svg { width: 16px; height: 16px; color: var(--green-bright); flex: none; margin-top: 3px; }
  .side-stats {
    margin-top: auto;
    padding-top: 1.5rem;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem;
    border-top: 1px solid var(--line);
  }
  .ss-v { display: block; font-family: var(--font-display); font-weight: 600; font-size: 1.25rem; color: var(--green-bright); }
  .ss-k { display: block; font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-4); margin-top: 0.2rem; }

  /* Form side */
  .auth-main { padding: clamp(1.75rem, 4vw, 2.75rem); background: var(--bg-3); }

  h1 { font-size: 1.9rem; text-align: center; }
  .switch { text-align: center; margin-top: 0.5rem; color: var(--text-3); font-size: 0.9rem; }
  .switch a { color: var(--green-bright); font-weight: 600; }
  .switch a:hover { text-decoration: underline; }

  /* ---- Social auth ---- */
  .social { display: grid; gap: 0.7rem; margin-top: 1.7rem; }
  .soc {
    display: flex; align-items: center; gap: 0.85rem;
    width: 100%;
    padding: 0.8rem 1rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    color: var(--text);
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .soc:hover { border-color: var(--green-line); background: rgba(255, 255, 255, 0.06); }
  .soc-icon { flex: none; display: grid; place-items: center; width: 22px; height: 22px; }
  .soc-icon svg { width: 100%; height: 100%; }
  .soc-label {
    flex: 1; text-align: center;
    font-family: var(--font-display); font-weight: 600;
    font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase;
    /* Offset the fixed-width icon so the label reads optically centred */
    margin-right: 22px;
  }

  .auth-form { display: grid; gap: 1rem; margin-top: 1.5rem; }
  .field { display: grid; gap: 0.4rem; }
  label { font-family: var(--font-display); font-size: 0.85rem; font-weight: 500; color: var(--text); }
  input[type='email'], input[type='text'], input[type='password'], input[type='tel'] {
    width: 100%;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    padding: 0.8rem 0.9rem;
    color: var(--text);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  input::placeholder { color: var(--text-4); }
  input:focus { outline: none; border-color: var(--green-bright); box-shadow: 0 0 0 3px rgba(23, 212, 139, 0.15); }
  .field.invalid input, .field.invalid .phone-row, .field.invalid .pw-row { border-color: #E4685F; }
  .err { color: #F08D84; font-size: 0.78rem; min-height: 1em; }

  /* ---- Composite fields: the wrapper is the visible control, so the
         inner input drops its own border/background ---- */
  .phone-row, .pw-row {
    display: flex; align-items: stretch;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .phone-row:focus-within, .pw-row:focus-within {
    border-color: var(--green-bright);
    box-shadow: 0 0 0 3px rgba(23, 212, 139, 0.15);
  }
  .phone-row input, .pw-row input {
    border: 0; background: transparent; border-radius: 0; min-width: 0;
  }
  .phone-row input:focus, .pw-row input:focus { box-shadow: none; }

  .dial {
    flex: none;
    appearance: none;
    background: transparent;
    border: 0;
    border-right: 1px solid var(--line);
    padding: 0.8rem 1.6rem 0.8rem 0.9rem;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.86rem;
    cursor: pointer;
    /* Caret drawn in CSS so the control keeps the site's field styling */
    background-image:
      linear-gradient(45deg, transparent 50%, var(--text-3) 50%),
      linear-gradient(135deg, var(--text-3) 50%, transparent 50%);
    background-position: calc(100% - 0.9rem) 55%, calc(100% - 0.6rem) 55%;
    background-size: 5px 5px, 5px 5px;
    background-repeat: no-repeat;
  }
  .dial:focus { outline: none; }
  .dial option { background: var(--bg-3); color: var(--text); }

  /* ---- Password reveal ---- */
  .pw-toggle {
    flex: none;
    display: grid; place-items: center;
    width: 44px;
    background: transparent; border: 0;
    color: var(--text-3);
    cursor: pointer;
    transition: color 0.2s ease;
  }
  .pw-toggle:hover { color: var(--text); }
  .pw-toggle svg { width: 18px; height: 18px; }
  .pw-toggle .eye-on { display: none; }
  .pw-toggle[aria-pressed='true'] .eye-off { display: none; }
  .pw-toggle[aria-pressed='true'] .eye-on { display: block; }

  .login-opts { display: grid; gap: 0.7rem; }
  .check { display: flex; align-items: center; gap: 0.5rem; font-family: var(--font-body); font-weight: 400; font-size: 0.85rem; color: var(--text-3); cursor: pointer; }
  .check input { accent-color: var(--green); width: 16px; height: 16px; flex: none; }
  .check.terms { align-items: flex-start; line-height: 1.55; }
  .check.terms input { margin-top: 2px; }
  .check.terms a { color: var(--green-bright); }
  .check.terms a:hover { text-decoration: underline; }
  .link-sm { font-size: 0.85rem; color: var(--green-bright); justify-self: end; }
  .link-sm:hover { text-decoration: underline; }

  .auth-submit { width: 100%; margin-top: 0.3rem; }
  .form-status { font-size: 0.88rem; text-align: center; min-height: 1.2em; }
  .form-status.info { color: var(--text-2); }
  .form-status.bad { color: #F08D84; }

  @media (max-width: 820px) {
    .auth-shell { grid-template-columns: 1fr; max-width: 460px; }
    .auth-side { display: none; }
  }
</style>

<script>
  const initAuthForm = () => {
    const form = document.getElementById('auth-form');
    const statusEl = document.getElementById('auth-status');
    if (!form || !statusEl || form.dataset.init) return;
    form.dataset.init = 'true';

    const isLogin = form.dataset.mode === 'login';

    const setError = (name, msg) => {
      const field = form.querySelector(`[name="${name}"]`)?.closest('.field');
      const err = form.querySelector(`.err[data-for="${name}"]`);
      if (field) field.classList.toggle('invalid', Boolean(msg));
      if (err) err.textContent = msg;
    };

    const validate = () => {
      let ok = true;
      const data = new FormData(form);

      if (isLogin) {
        const username = (data.get('username') || '').toString().trim();
        setError('username', username ? '' : 'Enter your username.');
        if (!username) ok = false;
      } else {
        const name = (data.get('name') || '').toString().trim();
        setError('name', name ? '' : 'Please enter your name.');
        if (!name) ok = false;

        const email = (data.get('email') || '').toString().trim();
        const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
        setError('email', emailOk ? '' : 'Enter a valid email.');
        if (!emailOk) ok = false;

        // Digits only, ignoring separators the user may type for readability
        const phone = (data.get('phone') || '').toString().replace(/[\s()\-.]/g, '');
        const phoneOk = /^\d{6,15}$/.test(phone);
        setError('phone', phoneOk ? '' : 'Enter a valid phone number.');
        if (!phoneOk) ok = false;
      }

      const pw = (data.get('password') || '').toString();
      const pwOk = isLogin ? pw.length > 0 : pw.length >= 8;
      setError('password', pwOk ? '' : (isLogin ? 'Enter your password.' : 'Use at least 8 characters.'));
      if (!pwOk) ok = false;

      if (!isLogin) {
        const terms = form.querySelector('[name="terms"]');
        if (terms && !terms.checked) {
          ok = false;
          statusEl.textContent = 'Please accept the Terms, Privacy Policy & Risk Disclosure to continue.';
          statusEl.className = 'form-status bad';
        }
      }
      return ok;
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      statusEl.textContent = '';
      statusEl.className = 'form-status';
      if (!validate()) return;
      statusEl.textContent = isLogin
        ? "Preview build — sign-in isn't connected to a backend yet."
        : "Thanks! Accounts aren't open yet in this preview — we'll be in touch.";
      statusEl.classList.add('info');
    });

    form.querySelectorAll('input').forEach((el) => {
      el.addEventListener('input', () => {
        const field = el.closest('.field');
        if (field && field.classList.contains('invalid')) setError(el.name, '');
      });
    });

    // Password reveal (login only)
    const pwToggle = form.querySelector('.pw-toggle');
    const pwInput = form.querySelector('#password');
    if (pwToggle && pwInput) {
      pwToggle.addEventListener('click', () => {
        const shown = pwToggle.getAttribute('aria-pressed') === 'true';
        pwToggle.setAttribute('aria-pressed', shown ? 'false' : 'true');
        pwToggle.setAttribute('aria-label', shown ? 'Show password' : 'Hide password');
        pwInput.type = shown ? 'password' : 'text';
      });
    }

    // Social buttons are placeholders until an auth backend is wired up.
    document.querySelectorAll('.soc').forEach((btn) => {
      btn.addEventListener('click', () => {
        statusEl.textContent = `Preview build — ${btn.dataset.provider} sign-in isn't connected yet.`;
        statusEl.className = 'form-status info';
      });
    });
  };

  document.addEventListener('astro:page-load', initAuthForm);
</script>
