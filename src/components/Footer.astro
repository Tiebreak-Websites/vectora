---
import Logo from './Logo.astro';

const year = new Date().getFullYear();

const cols = [
  {
    title: 'Product',
    links: [
      { href: '/packages', label: 'Packages' },
      { href: '/algos', label: 'Algos' },
      { href: '/strategy', label: 'Strategy' },
      { href: '/analytics', label: 'Analytics' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/support', label: 'Support' },
      { href: '/login', label: 'Log in' },
      { href: '/signup', label: 'Sign up' },
    ],
  },
  {
    title: 'Compliance',
    links: [
      { href: '#', label: 'Risk Disclosure' },
      { href: '#', label: 'Refund Policy' },
      { href: '#', label: 'Privacy Policy' },
      { href: '#', label: 'Terms of Service' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="foot-top">
      <div class="foot-brand">
        <a href="/" aria-label="Vectora home"><Logo height={34} /></a>
        <a href="/support" class="btn btn-outline foot-cta">Request a call</a>
      </div>

      <div class="foot-cols">
        {cols.map((c) => (
          <nav class="foot-col" aria-label={c.title}>
            <h4>{c.title}</h4>
            <ul>{c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
          </nav>
        ))}
      </div>
    </div>

    <hr class="foot-divider" />

    <p class="disclaimer">
      Vectora algos are automated trading tools offered through technically
      compatible broker platforms. Clients choose a package and algo
      selection; once activated, algos execute their strategies independently.
      Our team provides technical setup assistance, not investment advice.
    </p>
    <p class="disclaimer">
      *ROI and performance figures are approximate "up to" values based on
      historical, backtested, or tracked results. Past performance is not
      indicative of future results and returns are not guaranteed. Trading
      involves risk and can result in loss of capital.
    </p>

    <div class="foot-bottom">
      <p>© {year} Vectora. All rights reserved.</p>
      <div class="socials" aria-label="Social links">
        <a href="#" aria-label="X / Twitter"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2H22l-7.5 8.6L23 22h-6.8l-5.3-7-6.1 7H1.6l8-9.2L1 2h7l4.8 6.3L18.9 2zm-2.4 18h1.9L7.6 4H5.6l10.9 16z"/></svg></a>
        <a href="#" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.94 7.5a1.94 1.94 0 11-.01-3.88A1.94 1.94 0 016.94 7.5zM5.3 9h3.3v10.5H5.3V9zm5.4 0h3.16v1.43h.05c.44-.83 1.5-1.7 3.1-1.7 3.32 0 3.93 2.18 3.93 5.02v5.75h-3.3v-5.1c0-1.22-.02-2.78-1.7-2.78-1.7 0-1.96 1.33-1.96 2.7v5.18h-3.3V9z"/></svg></a>
        <a href="#" aria-label="Telegram"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M21.9 4.3l-3 14.1c-.2 1-.8 1.2-1.7.8l-4.6-3.4-2.2 2.1c-.2.2-.5.5-.9.5l.3-4.7L18.4 5c.4-.3-.1-.5-.6-.2L6.6 11.6l-4.6-1.4c-1-.3-1-1 .2-1.5l18-6.9c.8-.3 1.6.2 1.3 1.5z"/></svg></a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(3.5rem, 7vw, 5.5rem) 2rem;
    background:
      radial-gradient(50rem 24rem at 50% -8rem, rgba(9, 161, 101, 0.09), transparent 65%),
      var(--bg-2);
    color: var(--text-3);
    border-top: 1px solid var(--line);
    position: relative;
  }
  .site-footer::before {
    content: '';
    position: absolute;
    top: -1px; left: 10%; right: 10%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--green-line), transparent);
  }

  .foot-top {
    display: grid;
    grid-template-columns: 1.2fr 2fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .foot-brand { display: flex; flex-direction: column; align-items: flex-start; gap: 1.5rem; }
  .foot-cta { font-size: 0.88rem; padding: 0.75rem 1.15rem; }

  .foot-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .foot-col h4 {
    font-family: var(--font-mono); font-weight: 500;
    font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.14em;
    color: var(--text-4); margin-bottom: 1.1rem;
  }
  .foot-col ul { display: grid; gap: 0.7rem; }
  .foot-col a {
    color: var(--text-2); font-size: 0.94rem;
    transition: color 0.2s ease, padding-left 0.2s ease;
  }
  .foot-col a:hover { color: var(--green-bright); padding-left: 4px; }

  .foot-divider { height: 1px; border: 0; background: var(--line); margin-top: clamp(2.25rem, 5vw, 3.5rem); }

  .disclaimer {
    width: 100%;
    margin-top: 1.5rem;
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--text-4);
  }
  .disclaimer + .disclaimer { margin-top: 0.6rem; }

  .foot-bottom {
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 1rem;
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.85rem; color: var(--text-4);
  }
  .socials { display: flex; gap: 0.6rem; }
  .socials a {
    width: 36px; height: 36px; display: grid; place-items: center; border-radius: var(--radius-sm);
    border: 1px solid var(--line-strong); color: var(--text-3);
    transition: color 0.2s ease, border-color 0.2s ease, box-shadow 0.25s ease, transform 0.2s ease;
  }
  .socials a:hover { color: var(--green-bright); border-color: var(--green-line); box-shadow: 0 0 18px -6px var(--green-glow); transform: translateY(-2px); }
  .socials svg { width: 17px; height: 17px; }

  @media (max-width: 860px) {
    .foot-top { grid-template-columns: 1fr; }
    .foot-cols { gap: 1.5rem; }
  }
  @media (max-width: 560px) {
    .foot-cols { grid-template-columns: 1fr 1fr; }
    .foot-bottom { flex-direction: column; align-items: flex-start; }
  }
</style>
