---
import Logo from './Logo.astro';

const year = new Date().getFullYear();

const cols = [
  {
    title: 'Product',
    links: [
      { href: '/packages', label: 'Our Packages' },
      { href: '/bots', label: 'Our Bots' },
      { href: '/#strategy', label: 'Strategy' },
      { href: '/results', label: 'Results' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '#', label: 'About' },
      { href: '#', label: 'Blog' },
      { href: '#', label: 'Careers' },
      { href: '/support', label: 'Support' },
    ],
  },
  {
    title: 'Compliance',
    links: [
      { href: '#', label: 'Risk Disclosure' },
      { href: '#', label: 'Terms of Service' },
      { href: '#', label: 'Privacy Policy' },
      { href: '#', label: 'FCA Compliance' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="foot-grid">
      <div class="foot-brand">
        <Logo height={28} />
        <p>Institutional-grade AI trading bots that execute your strategy 24/7 — built for speed, precision and trust.</p>
        <div class="socials" aria-label="Social links">
          <a href="#" aria-label="X / Twitter"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2H22l-7.5 8.6L23 22h-6.8l-5.3-7-6.1 7H1.6l8-9.2L1 2h7l4.8 6.3L18.9 2zm-2.4 18h1.9L7.6 4H5.6l10.9 16z"/></svg></a>
          <a href="#" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.94 7.5a1.94 1.94 0 11-.01-3.88A1.94 1.94 0 016.94 7.5zM5.3 9h3.3v10.5H5.3V9zm5.4 0h3.16v1.43h.05c.44-.83 1.5-1.7 3.1-1.7 3.32 0 3.93 2.18 3.93 5.02v5.75h-3.3v-5.1c0-1.22-.02-2.78-1.7-2.78-1.7 0-1.96 1.33-1.96 2.7v5.18h-3.3V9z"/></svg></a>
          <a href="#" aria-label="Telegram"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M21.9 4.3l-3 14.1c-.2 1-.8 1.2-1.7.8l-4.6-3.4-2.2 2.1c-.2.2-.5.5-.9.5l.3-4.7L18.4 5c.4-.3-.1-.5-.6-.2L6.6 11.6l-4.6-1.4c-1-.3-1-1 .2-1.5l18-6.9c.8-.3 1.6.2 1.3 1.5z"/></svg></a>
        </div>
      </div>

      {cols.map((c) => (
        <nav class="foot-col" aria-label={c.title}>
          <h4>{c.title}</h4>
          <ul>{c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </nav>
      ))}
    </div>

    <hr class="divider" />

    <div class="foot-bottom">
      <p>© {year} Vectora. All rights reserved.</p>
      <p class="risk">Trading involves risk of loss. Not investment advice.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--c-border); padding-block: clamp(3rem, 6vw, 4.5rem) 2rem; background: var(--c-bg-deep); }
  .foot-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 2rem; }
  .foot-brand p { color: var(--c-text-muted); font-size: 0.92rem; margin: 1rem 0 1.25rem; max-width: 34ch; }
  .socials { display: flex; gap: 0.6rem; }
  .socials a {
    width: 38px; height: 38px; display: grid; place-items: center; border-radius: 10px;
    border: 1px solid var(--c-border-strong); color: var(--c-text-muted);
    transition: color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .socials a:hover { color: var(--c-accent-bright); border-color: var(--c-accent); transform: translateY(-2px); }
  .socials svg { width: 18px; height: 18px; }

  .foot-col h4 { font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--c-text-dim); margin-bottom: 1rem; }
  .foot-col ul { display: grid; gap: 0.65rem; }
  .foot-col a { color: var(--c-text-muted); font-size: 0.94rem; transition: color 0.2s ease; }
  .foot-col a:hover { color: var(--c-text); }

  .foot-bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; color: var(--c-text-dim); font-size: 0.85rem; }

  @media (max-width: 760px) { .foot-grid { grid-template-columns: 1fr 1fr; } .foot-brand { grid-column: 1 / -1; } }
  @media (max-width: 440px) { .foot-grid { grid-template-columns: 1fr; } }
</style>
