---
// Official copy. Home uses the defaults; the Strategy page passes its own
// body and steps via props.
const {
  body = 'From sign-up to guided bot setup in three clear steps. No hype, no black box, and no need to watch every tick alone.',
  steps = [
    {
      n: '01',
      title: 'Connect',
      body: 'Open or join through one of our supported brokers and choose the instrument package that fits your trading goals.',
    },
    {
      n: '02',
      title: 'Configure',
      body: 'Set your package, preferred bot, and risk preferences with support from our team.',
    },
    {
      n: '03',
      title: 'Activate',
      body: 'The bot starts monitoring selected conditions and sending trade context. You stay responsible for the final action.',
    },
  ],
} = Astro.props;
---

<section class="section how" id="how-it-works">
  <div class="container">
    <div class="section-head reveal">
      <h2>Trading <span class="grad-text">simplified</span></h2>
      <p>{body}</p>
    </div>

    <div class="how-grid">
      <ol class="steps reveal">
        {steps.map((s) => (
          <li class="step">
            <span class="step-n">{s.n}</span>
            <div><h3>{s.title}</h3><p>{s.body}</p></div>
          </li>
        ))}
      </ol>

      <div class="term card reveal" style="--reveal-delay:150ms" aria-hidden="true">
        <div class="term-top">
          <span class="dots"><i></i><i></i><i></i></span>
          <span class="term-title">vectora · guardian engine</span>
          <span class="term-live"><span class="lp"></span> 24/7</span>
        </div>
        <div class="term-body" id="term-body"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .how { background: var(--bg-2); border-block: 1px solid var(--line); }
  .how-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 4.5rem); align-items: center; }

  .steps { display: grid; gap: 1.35rem; }
  .step { display: flex; gap: 1.05rem; align-items: flex-start; }
  .step-n {
    flex: none; width: 40px; height: 40px;
    display: grid; place-items: center; border-radius: var(--radius-sm);
    font-family: var(--font-mono); font-weight: 500; font-size: 0.85rem;
    color: var(--green-bright); background: var(--green-tint);
    border: 1px solid rgba(23, 212, 139, 0.22);
  }
  .step h3 { font-size: 1.12rem; }
  .step p { color: var(--text-3); font-size: 0.94rem; margin-top: 0.25rem; max-width: 48ch; }

  /* Terminal — continuously running guardian-engine log */
  .term { padding: 0; overflow: hidden; background: rgba(8, 13, 11, 0.9); }
  .term-top {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0.8rem 1.1rem; border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.025);
  }
  .dots { display: inline-flex; gap: 6px; }
  .dots i { width: 10px; height: 10px; border-radius: 50%; background: var(--line-strong); }
  .dots i:first-child { background: #E4685F; }
  .dots i:nth-child(2) { background: #E0B450; }
  .dots i:last-child { background: var(--green-bright); }
  .term-title { font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-3); }
  .term-live { margin-left: auto; display: inline-flex; align-items: center; gap: 0.4rem; font-family: var(--font-mono); font-size: 0.72rem; color: var(--green-bright); }
  .lp { width: 7px; height: 7px; border-radius: 50%; background: var(--green-bright); animation: tpulse 1.6s infinite; }
  @keyframes tpulse { 0% { box-shadow: 0 0 0 0 rgba(23, 212, 139, 0.5); } 100% { box-shadow: 0 0 0 9px rgba(23, 212, 139, 0); } }

  .term-body {
    padding: 1.1rem 1.2rem 1.3rem;
    font-family: var(--font-mono); font-size: 0.8rem;
    display: flex; flex-direction: column; justify-content: flex-end;
    gap: 0.6rem;
    height: 252px;
    overflow: hidden;
  }
  .term-body :global(.logline) {
    display: flex; gap: 0.7rem; align-items: center; white-space: nowrap;
    animation: login 0.45s ease;
  }
  @keyframes login { from { opacity: 0; transform: translateY(8px); } }
  .term-body :global(.lt) { color: var(--text-4); }
  .term-body :global(.ls) { font-weight: 500; padding: 0.1rem 0.45rem; border-radius: 4px; font-size: 0.7rem; }
  .term-body :global(.ls.buy) { color: #04281A; background: var(--green-bright); }
  .term-body :global(.ls.sell) { color: #fff; background: rgba(228, 104, 95, 0.85); }
  .term-body :global(.ls.risk) { color: var(--green-bright); background: var(--green-tint); }
  .term-body :global(.ls.scan) { color: var(--text-3); background: rgba(255, 255, 255, 0.07); }
  .term-body :global(.ld) { color: var(--text-2); overflow: hidden; text-overflow: ellipsis; }

  @media (max-width: 900px) { .how-grid { grid-template-columns: 1fr; } }
</style>

<script>
  // Guardian-engine log — official copy lines, cycled. Decorative
  // (aria-hidden). Pauses on reduced-motion.
  const POOL = [
    { t: '09:31:02', s: 'BUY', d: 'BTC setup detected · risk context ready', cls: 'buy' },
    { t: '09:31:09', s: 'RISK', d: 'volatility rising · review before action', cls: 'risk' },
    { t: '10:14:48', s: 'SELL', d: 'Gold signal locked · check exposure', cls: 'sell' },
    { t: '11:02:17', s: 'BUY', d: 'USD/JPY movement confirmed', cls: 'buy' },
    { t: '11:46:30', s: 'SCAN', d: 'no setup · holding', cls: 'scan' },
  ];

  const initTerminal = () => {
    const body = document.getElementById('term-body');
    if (!body || body.dataset.init) return;
    body.dataset.init = 'true';

    let idx = 0;

    const addLine = () => {
      const item = POOL[idx % POOL.length];
      idx++;

      const line = document.createElement('div');
      line.className = 'logline';
      line.innerHTML =
        `<span class="lt">${item.t}</span>` +
        `<span class="ls ${item.cls}">${item.s}</span>` +
        `<span class="ld">${item.d}</span>`;
      body.appendChild(line);
      while (body.children.length > 7) body.removeChild(body.children[0]);
    };

    // Seed the full official sequence immediately.
    for (let i = 0; i < POOL.length; i++) addLine();

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const timer = setInterval(addLine, 2600);
    document.addEventListener('astro:before-swap', () => clearInterval(timer), { once: true });
  };

  document.addEventListener('astro:page-load', initTerminal);
</script>
