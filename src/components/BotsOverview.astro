---
const bots = [
  {
    name: 'Mira',
    market: 'Gold',
    pair: 'XAU/USD',
    roi: '3–5%',
    package: 'Foundation package',
    body: 'A steady, defensive engine. Mira trades gold with strict per-trade risk caps — built for consistency over excitement.',
    spark: 'M2 30 L14 26 L26 28 L38 22 L50 24 L62 18 L74 20 L86 14 L98 16 L110 10',
  },
  {
    name: 'Axon',
    market: 'Bitcoin',
    pair: 'BTC/USD',
    roi: '5–7%',
    package: 'Advanced package',
    body: 'Our highest-yield engine. Axon reads momentum and liquidity in the Bitcoin market and executes without hesitation.',
    spark: 'M2 32 L14 24 L26 27 L38 16 L50 21 L62 12 L74 17 L86 8 L98 12 L110 4',
  },
  {
    name: 'Kairo',
    market: 'Forex',
    pair: 'USD/JPY',
    roi: '4–6%',
    package: 'Professional package',
    body: 'A precision scalper. Kairo works the USD/JPY corridor — many small, controlled trades rather than big bets.',
    spark: 'M2 28 L14 24 L26 26 L38 20 L50 23 L62 17 L74 19 L86 13 L98 15 L110 8',
  },
];
---

<section class="section bots-overview">
  <div class="container">
    <div class="section-head reveal">
      <h2>Specialists, <span class="grad-text">not generalists</span></h2>
      <p>
        We deliberately trade three markets only — gold, Bitcoin and USD/JPY.
        Each bot masters one market, and every trade goes through the brokers
        we work with directly.
      </p>
    </div>

    <div class="bot-grid">
      {bots.map((b, i) => (
        <article class="card hoverable spot bot reveal" style={`--reveal-delay:${i * 90}ms`}>
          <div class="bot-top">
            <h3>{b.name}</h3>
            <span class="pair">{b.pair}</span>
          </div>
          <span class="market">{b.market}</span>
          <p class="body">{b.body}</p>

          <svg class="spark" viewBox="0 0 112 36" aria-hidden="true" preserveAspectRatio="none">
            <path d={b.spark} fill="none" stroke="url(#sparkgrad)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>

          <div class="bot-foot">
            <div>
              <span class="roi figure">{b.roi}</span>
              <span class="figure-label">Target / month</span>
            </div>
            <a href="/packages" class="pkg">{b.package} →</a>
          </div>
        </article>
      ))}
    </div>

    <svg width="0" height="0" aria-hidden="true">
      <defs>
        <linearGradient id="sparkgrad" x1="0" y1="1" x2="1" y2="0">
          <stop offset="0" stop-color="#09A165" />
          <stop offset="1" stop-color="#17D48B" />
        </linearGradient>
      </defs>
    </svg>
  </div>
</section>

<style>
  .bots-overview { padding-top: clamp(2.5rem, 6vw, 4.5rem); }
  .bot-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .bot { display: flex; flex-direction: column; }
  .bot-top { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .bot-top h3 { font-size: 1.55rem; }
  .pair { font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-4); letter-spacing: 0.06em; }
  .market {
    display: inline-block; margin-top: 0.5rem; align-self: flex-start;
    font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--green-bright); background: var(--green-tint);
    border: 1px solid rgba(23, 212, 139, 0.25);
    padding: 0.3rem 0.6rem; border-radius: 4px;
  }
  .body { color: var(--text-3); font-size: 0.95rem; margin-top: 1rem; flex: 1; }

  .spark { width: 100%; height: 42px; margin-top: 1.25rem; opacity: 0.9; }

  .bot-foot {
    display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem;
    margin-top: 1rem; padding-top: 1.15rem; border-top: 1px solid var(--line);
  }
  .roi { display: block; font-size: 1.7rem; color: var(--green-bright); }
  .pkg {
    font-family: var(--font-display); font-size: 0.88rem; font-weight: 600; color: var(--text);
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 2px;
    transition: border-color 0.2s ease, color 0.2s ease;
    white-space: nowrap;
  }
  .pkg:hover { color: var(--green-bright); border-color: var(--green); }

  @media (max-width: 900px) { .bot-grid { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; } }
</style>
