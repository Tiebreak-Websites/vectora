---
// Official copy: homepage stats strip.
const metrics = [
  { v: '25–32%', k: 'Yearly ROI range' },
  { v: '4,000+', k: 'Private clients', count: 4000, suffix: '+' },
  { v: '548 days', k: 'Live + backtested operation' },
];
---

<section class="band" aria-label="Key figures">
  <div class="container">
    <ul class="band-grid reveal">
      {metrics.map((m) => (
        <li>
          {m.count
            ? <span class="bv" data-count={m.count} data-suffix={m.suffix ?? ''}>{m.v}</span>
            : <span class="bv">{m.v}</span>}
          <span class="bk">{m.k}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .band {
    position: relative;
    background:
      radial-gradient(60rem 30rem at 50% 130%, rgba(9, 161, 101, 0.14), transparent 65%),
      var(--bg-2);
    border-block: 1px solid var(--line);
    padding-block: clamp(2.75rem, 6vw, 4.5rem);
    overflow: hidden;
  }
  .band::before {
    content: '';
    position: absolute;
    top: -1px; left: 15%; right: 15%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--green-line), transparent);
  }

  .band-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem 1rem;
    text-align: center;
  }
  .bv {
    display: block;
    font-family: var(--font-display); font-weight: 600; letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    font-size: clamp(2rem, 4.4vw, 3.1rem);
    background: var(--grad-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .bk {
    display: block; margin-top: 0.4rem;
    font-family: var(--font-mono); font-size: 0.72rem;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-4);
  }

  @media (max-width: 640px) { .band-grid { grid-template-columns: 1fr; gap: 1.75rem; } }
</style>
