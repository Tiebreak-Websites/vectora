---
// Confirmed performance figures — static, reviewed with the product team.
const metrics = [
  { v: '25–32%', k: 'Yearly ROI' },
  { v: '4–5%', k: 'Avg. monthly ROI' },
  { v: '92%', k: 'Win rate, all bots', count: 92, suffix: '%' },
  { v: '1–2%', k: 'Drawdown, all bots' },
  { v: '548', k: 'Days live + backtested', count: 548 },
];
---

<section class="band" aria-label="Performance metrics">
  <div class="container">
    <div class="band-head reveal">
      <h2>Measured, <span class="grad-text">not promised</span></h2>
      <p class="band-sub">Figures across all three bots, from live trading plus 1.5 years of backtesting.</p>
    </div>
    <ul class="band-grid reveal" style="--reveal-delay:100ms">
      {metrics.map((m) => (
        <li>
          {m.count
            ? <span class="bv" data-count={m.count} data-suffix={m.suffix ?? ''}>{m.v}</span>
            : <span class="bv">{m.v}</span>}
          <span class="bk">{m.k}</span>
        </li>
      ))}
    </ul>
    <p class="band-note reveal" style="--reveal-delay:180ms">
      Static figures, reviewed quarterly with the product team.
    </p>
  </div>
</section>

<style>
  .band {
    position: relative;
    background:
      radial-gradient(60rem 30rem at 50% 120%, rgba(9, 161, 101, 0.14), transparent 65%),
      var(--bg-2);
    border-block: 1px solid var(--line);
    padding-block: clamp(3.5rem, 8vw, 6rem);
    overflow: hidden;
  }
  .band::before {
    content: '';
    position: absolute;
    top: -1px; left: 15%; right: 15%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--green-line), transparent);
  }
  .band-head { text-align: center; max-width: 680px; margin-inline: auto; }
  .band-head h2 { font-size: clamp(1.9rem, 4vw, 2.8rem); }
  .band-sub { color: var(--text-3); margin-top: 1rem; }

  .band-grid {
    display: grid; grid-template-columns: repeat(5, 1fr); gap: 1.5rem 1rem;
    margin-top: clamp(2rem, 5vw, 3rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
    text-align: center;
  }
  .bv {
    display: block;
    font-family: var(--font-display); font-weight: 600; letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    font-size: clamp(1.7rem, 3.6vw, 2.5rem);
    background: var(--grad-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .bk {
    display: block; margin-top: 0.35rem;
    font-family: var(--font-mono); font-size: 0.7rem;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-4);
  }
  .band-note { margin-top: clamp(1.75rem, 4vw, 2.5rem); font-size: 0.85rem; color: var(--text-4); text-align: center; }

  @media (max-width: 900px) { .band-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 560px) { .band-grid { grid-template-columns: repeat(2, 1fr); } }
</style>
