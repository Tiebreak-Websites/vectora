---
const { section } = Astro.props;

// Official copy: "The Power of Algo Trading" feature cards.
const features = [
  {
    n: "01",
    title: "24/7 Market Monitoring",
    body: "Vectora follows selected conditions in the background and helps surface moments that may deserve attention.",
  },
  {
    n: "02",
    title: "Emotion Check",
    body: "Fast markets create pressure. Rules-based execution keeps every setup structured — no fear or impulse in the loop.",
  },
  {
    n: "03",
    title: "Real-Time Risk Context",
    body: "See risk context around a setup, including movement, volatility, and exposure pressure.",
  },
  {
    n: "04",
    title: "Automated Execution",
    body: "You choose the package and algo selection. Once activated, the algo operates independently and executes its strategy within defined rules.",
  },
];
---

<section class="section why" id="why">
  <div class="container">
    <div class="section-head reveal">
      <h2>{section.headline}</h2>
    </div>

    <div class="why-grid">
      {
        section.items.map((f, i) => (
          <article class="why-item reveal" style={`--reveal-delay:${i * 70}ms`}>
            <span class="wn">{f.n}</span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .why-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
  }
  .why-item {
    position: relative;
    padding: 1.75rem 1.5rem 1.75rem 0;
    border-bottom: 1px solid var(--line);
    transition: background 0.25s ease;
  }
  .why-item::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--line-strong);
    transition: width 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .why-item:hover::before {
    width: 100%;
  }
  .why-item + .why-item {
    border-left: 1px solid var(--line);
    padding-left: 1.5rem;
  }
  .wn {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-4);
  }
  .why-item h3 {
    font-size: 1.12rem;
    margin-top: 0.8rem;
  }
  .why-item p {
    color: var(--text-3);
    font-size: 0.93rem;
    margin-top: 0.55rem;
  }

  @media (max-width: 900px) {
    .why-grid {
      grid-template-columns: 1fr 1fr;
    }
    .why-item:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }
  }
  @media (max-width: 560px) {
    .why-grid {
      grid-template-columns: 1fr;
    }
    .why-item + .why-item {
      border-left: 0;
      padding-left: 0;
    }
  }
</style>
