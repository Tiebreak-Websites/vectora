---
// Client reviews — measured, experience-focused quotes. Compliance: quotes
// describe setup, transparency, and support — never returns or profit
// claims — and the note below ties them to the risk disclaimer. Only
// Foundation is available today, so every reviewer runs a single algo.
const reviews = [
  {
    quote:
      'The onboarding call walked me through the whole broker setup and Mira was live in my account the same afternoon. Every trade shows up in my own account, which is exactly what I wanted to see.',
    name: 'Daniel K.',
    meta: 'Munich · Foundation — MIRA',
  },
  {
    quote:
      'I used to close positions on emotion and regret it a day later. Watching Axon wait for its confirmations instead of chasing every move has honestly changed how I think about trading.',
    name: 'Elena M.',
    meta: 'Rotterdam · Foundation — AXON',
  },
  {
    quote:
      "What convinced me was the honesty. No promised returns, 'up to' figures with the risks spelled out, and a guardian check around every setup. Kairo has behaved exactly as described.",
    name: 'Stefan P.',
    meta: 'Vienna · Foundation — KAIRO',
  },
  {
    quote:
      'Support answered every technical question within a few hours, even on a Sunday. The 60-day refund period is what made trying it feel safe — I never ended up needing it.',
    name: 'Amira H.',
    meta: 'Dubai · Foundation — MIRA',
  },
  {
    quote:
      'No pooled funds, no black box. The algo runs in my own broker account and I can audit every position against the chart. That transparency is why I stayed after the first month.',
    name: 'James W.',
    meta: 'Manchester · Foundation — AXON',
  },
  {
    quote:
      "I don't have time to watch the Nasdaq all day. Kairo monitors it for me and only acts when its conditions line up. The discipline is the product — the rest is noise.",
    name: 'Sofia R.',
    meta: 'Limassol · Foundation — KAIRO',
  },
];

const initials = (name) =>
  name
    .split(' ')
    .map((part) => part[0])
    .join('')
    .replace('.', '');
---

<section class="section reviews" id="reviews">
  <div class="container">
    <div class="section-head reveal">
      <h2>What our clients say</h2>
      <p>Private clients on setup, transparency, and day-to-day use of their algos.</p>
    </div>

    <div class="rev-grid">
      {reviews.map((r, i) => (
        <figure class="rev card spot reveal" style={`--reveal-delay:${i * 70}ms`}>
          <span class="rev-stars" role="img" aria-label="Rated 5 out of 5">
            {[0, 1, 2, 3, 4].map(() => (
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.6l2.86 5.8 6.4.93-4.63 4.51 1.09 6.37L12 17.2l-5.72 3.01 1.09-6.37L2.74 9.33l6.4-.93L12 2.6z"/></svg>
            ))}
          </span>
          <blockquote>{r.quote}</blockquote>
          <figcaption>
            <span class="rev-avatar" aria-hidden="true">{initials(r.name)}</span>
            <span class="rev-who">
              <span class="rev-name">{r.name}</span>
              <span class="rev-meta">{r.meta}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>

    <p class="rev-note">
      Testimonials reflect individual client experiences with setup, support,
      and platform use. They are not indicative of future results and are not
      investment advice.
    </p>
  </div>
</section>

<style>
  .rev-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.1rem;
    align-items: stretch;
  }
  .rev {
    display: flex;
    flex-direction: column;
    padding: 1.6rem 1.5rem 1.45rem;
  }
  .rev-stars { display: inline-flex; gap: 3px; color: var(--green-bright); }
  .rev-stars svg { width: 14px; height: 14px; }
  .rev blockquote {
    flex: 1;
    margin-top: 0.95rem;
    color: var(--text-2);
    font-size: 0.94rem;
    line-height: 1.65;
  }
  .rev figcaption {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
    padding-top: 1.05rem;
    border-top: 1px solid var(--line);
  }
  .rev-avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--line-strong);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--text-2);
  }
  .rev-who { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .rev-name { font-family: var(--font-display); font-weight: 600; font-size: 0.92rem; color: var(--text); }
  .rev-meta { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.04em; color: var(--text-4); }

  .rev-note {
    margin-top: 1.5rem;
    text-align: center;
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--text-4);
  }

  @media (max-width: 980px) {
    .rev-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 620px) {
    .rev-grid { grid-template-columns: 1fr; max-width: 440px; margin-inline: auto; }
  }
</style>
