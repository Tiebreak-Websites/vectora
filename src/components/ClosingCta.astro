---
// Per-page closing CTA — copy passed in from the official doc.
const { title, body, primary, secondary } = Astro.props;
---

<section class="section closing">
  <div class="container closing-box grad-border spot reveal">
    <h2 set:html={title} />
    <p>{body}</p>
    <div class="closing-actions">
      <a href={primary.href} class="btn btn-primary btn-lg">{primary.label}</a>
      <a href={secondary.href} class="btn btn-outline btn-lg">{secondary.label}</a>
    </div>
  </div>
</section>

<style>
  .closing-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(2.5rem, 6vw, 4rem) clamp(1.5rem, 5vw, 3.25rem);
    border-radius: var(--radius-lg);
    position: relative;
    box-shadow: 0 0 70px -28px var(--green-glow);
  }
  .closing-box h2 { font-size: clamp(1.9rem, 4.2vw, 2.8rem); }
  .closing-box > p { color: var(--text-3); margin-top: 1rem; max-width: 56ch; }
  .closing-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.85rem; margin-top: 2rem; }

  @media (max-width: 560px) {
    .closing-actions { width: 100%; }
    .closing-actions .btn { width: 100%; }
  }
</style>
