---
const steps = [
  {
    n: '01',
    title: 'Connect',
    body: 'Securely link your existing brokerage or exchange via API with end-to-end encryption. Your funds never leave your account.',
  },
  {
    n: '02',
    title: 'Configure',
    body: 'Select your risk profile and asset classes. Our AI adapts to your individual strategy goals.',
  },
  {
    n: '03',
    title: 'Activate',
    body: 'Deploy the engine. Watch live trade logs as the AI manages entries and exits 24/7.',
  },
];

const log = [
  { t: '09:31:02', s: 'BUY', a: 'BTC-PERP', d: 'filled @ 64,210', cls: 'buy' },
  { t: '09:31:02', s: 'RISK', a: 'stop set', d: '−0.6% · 1.2R target', cls: 'risk' },
  { t: '10:14:48', s: 'SELL', a: 'ES Futures', d: '+1.8R locked', cls: 'sell' },
  { t: '11:02:17', s: 'BUY', a: 'EUR/USD', d: 'filled @ 1.0842', cls: 'buy' },
  { t: '11:46:30', s: 'SCAN', a: '4.2M ticks/s', d: 'no setup · holding', cls: 'scan' },
];
---

<section class="section strategy" id="strategy">
  <div class="container strat-grid">
    <div class="strat-intro reveal">
      <span class="eyebrow">How it works</span>
      <h2>Trading <span class="text-accent">simplified</span></h2>
      <p>From sign-up to live execution in three steps — no spreadsheets, no scripts, no staring at candles. The engine handles the rest, around the clock.</p>

      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step" style={`--reveal-delay:${i * 80}ms`}>
            <span class="step-n">{s.n}</span>
            <div><h3>{s.title}</h3><p>{s.body}</p></div>
          </li>
        ))}
      </ol>
    </div>

    <div class="term card reveal" style="--reveal-delay:150ms" aria-hidden="true">
      <div class="term-top">
        <span class="dots"><i></i><i></i><i></i></span>
        <span class="term-title">vectora · live engine</span>
        <span class="term-live"><span class="lp"></span> 24/7</span>
      </div>
      <div class="term-body">
        {log.map((l, i) => (
          <div class="logline" style={`--i:${i}`}>
            <span class="lt">{l.t}</span>
            <span class={`ls ${l.cls}`}>{l.s}</span>
            <span class="la">{l.a}</span>
            <span class="ld">{l.d}</span>
          </div>
        ))}
        <div class="logline cursor"><span class="lt">11:46:31</span><span class="caret"></span></div>
      </div>
    </div>
  </div>
</section>

<style>
  .strat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 4.5rem); align-items: center; }
  .strat-intro h2 { font-size: clamp(2rem, 4vw, 2.9rem); margin-top: 1rem; }
  .strat-intro > p { color: var(--c-text-muted); margin-top: 1.1rem; font-size: 1.05rem; max-width: 44ch; }

  .steps { margin-top: 2rem; display: grid; gap: 0.9rem; }
  .step { display: flex; gap: 1.05rem; align-items: flex-start; }
  .step-n {
    flex: none; width: 42px; height: 42px;
    display: grid; place-items: center; border-radius: 11px;
    font-family: var(--font-display); font-weight: 700; font-size: 0.95rem;
    color: var(--c-accent-bright); background: var(--c-accent-soft);
    border: 1px solid var(--glass-border);
  }
  .step h3 { font-size: 1.15rem; }
  .step p { color: var(--c-text-muted); font-size: 0.94rem; margin-top: 0.2rem; }

  /* Terminal visual */
  .term { padding: 0; overflow: hidden; }
  .term-top { display: flex; align-items: center; gap: 0.75rem; padding: 0.8rem 1rem; border-bottom: 1px solid var(--c-border); background: rgba(0,0,0,0.18); }
  .dots { display: inline-flex; gap: 6px; }
  .dots i { width: 11px; height: 11px; border-radius: 50%; background: var(--c-border-strong); }
  .dots i:first-child { background: #ef6a85; }
  .dots i:nth-child(2) { background: #e6b450; }
  .dots i:last-child { background: var(--c-accent-bright); }
  .term-title { font-family: var(--font-display); font-size: 0.82rem; color: var(--c-text-muted); }
  .term-live { margin-left: auto; display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.72rem; color: var(--c-accent-bright); }
  .lp { width: 7px; height: 7px; border-radius: 50%; background: var(--c-accent-bright); animation: pulse2 1.6s infinite; }
  @keyframes pulse2 { 0%{box-shadow:0 0 0 0 rgba(18,201,125,.5)} 100%{box-shadow:0 0 0 9px rgba(18,201,125,0)} }

  .term-body { padding: 1rem 1.1rem 1.2rem; font-family: 'SF Mono', ui-monospace, 'Cascadia Code', Consolas, monospace; font-size: 0.8rem; display: grid; gap: 0.55rem; min-height: 230px; }
  .logline { display: flex; gap: 0.7rem; align-items: center; opacity: 0; transform: translateX(-6px); animation: logIn 0.5s ease forwards; animation-delay: calc(var(--i) * 0.5s + 0.3s); white-space: nowrap; }
  @keyframes logIn { to { opacity: 1; transform: none; } }
  .lt { color: var(--c-text-dim); }
  .ls { font-weight: 700; padding: 0.1rem 0.4rem; border-radius: 5px; font-size: 0.7rem; }
  .ls.buy { color: #062A1B; background: var(--c-accent-bright); }
  .ls.sell { color: #fff; background: #ef6a85; }
  .ls.risk { color: var(--c-accent-bright); background: var(--c-accent-soft); }
  .ls.scan { color: var(--c-text-muted); background: rgba(255,255,255,0.08); }
  .la { color: var(--c-text-soft); font-weight: 600; }
  .ld { color: var(--c-text-muted); overflow: hidden; text-overflow: ellipsis; }
  .caret { display: inline-block; width: 8px; height: 15px; background: var(--c-accent-bright); animation: blink 1s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  @media (max-width: 900px) { .strat-grid { grid-template-columns: 1fr; } }
</style>
