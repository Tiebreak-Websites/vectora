---
const bots = [
  {
    name: 'MIRA',
    tag: 'Gold · XAU',
    desc: 'High-frequency scalping engine for gold markets, with a zero-drawdown beta record across volatile cycles.',
    stats: [
      { k: 'Target ROI', v: '3–5%' },
      { k: 'Strategy', v: 'H-F Scalp' },
      { k: 'Drawdown', v: '0.00%' },
    ],
    featured: false,
  },
  {
    name: 'AXON',
    tag: 'Bitcoin · BTC',
    desc: 'Cryptographic analysis and liquidity-gap scoring across 40+ signals for relentless crypto execution.',
    stats: [
      { k: 'Target ROI', v: '5–8%' },
      { k: 'Strategy', v: 'H-F Scalp' },
      { k: 'Drawdown', v: '0.00%' },
    ],
    featured: true,
  },
  {
    name: 'KAIRO',
    tag: 'Indices · Nasdaq',
    desc: 'High-frequency scalping and mean reversion across Nasdaq index liquidity, mapping order flow in real time.',
    stats: [
      { k: 'Target ROI', v: '4–6%' },
      { k: 'Strategy', v: 'H-F Scalp' },
      { k: 'Drawdown', v: '0.00%' },
    ],
    featured: false,
  },
];
---

<section class="section bots" id="bots">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Our Algos</span>
      <h2>An algo for <span class="text-accent">every market regime</span></h2>
      <p>Markets trend, they range, they snap back. Run one algo or combine them into an all-weather portfolio that adapts as conditions change.</p>
    </div>

    <div class="bot-grid">
      {bots.map((b, i) => (
        <article class={`card bot reveal ${b.featured ? 'featured' : ''}`} style={`--reveal-delay:${i * 90}ms`}>
          {b.featured && <span class="badge">Most popular</span>}
          <span class="bot-tag">{b.tag}</span>
          <h3>{b.name}</h3>
          <p class="bot-desc">{b.desc}</p>
          <ul class="bot-stats">
            {b.stats.map((s) => (
              <li><span class="v">{s.v}</span><span class="k">{s.k}</span></li>
            ))}
          </ul>
          <a href="/algos" class="bot-link">View {b.name} <span class="arrow" aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .bot-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .bot { position: relative; display: flex; flex-direction: column; overflow: hidden; }
  .bot::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 3px; background: var(--grad-accent); opacity: 0.85; }
  .bot.featured { border-color: rgba(18, 201, 125, 0.4); box-shadow: var(--glow-accent); }
  .badge {
    position: absolute; top: 1rem; right: 1rem;
    font-family: var(--font-display); font-size: 0.66rem; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase;
    padding: 0.3rem 0.6rem; border-radius: var(--radius-pill);
    color: #062A1B; background: var(--grad-accent);
  }
  .bot-tag { font-family: var(--font-display); font-size: 0.76rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--c-accent-bright); }
  .bot h3 { font-size: 1.5rem; margin-top: 0.35rem; }
  .bot-desc { color: var(--c-text-muted); font-size: 0.95rem; margin-top: 0.7rem; }
  .bot-stats {
    padding: 1.1rem 0; margin: 1.1rem 0;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem;
    border-top: 1px solid var(--c-border); border-bottom: 1px solid var(--c-border);
  }
  .bot-stats .v { display: block; font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; color: var(--c-text); }
  .bot-stats .k { color: var(--c-text-dim); font-size: 0.72rem; }
  .bot-link { margin-top: auto; font-family: var(--font-display); font-weight: 600; color: var(--c-text); display: inline-flex; gap: 0.4rem; align-items: center; transition: color 0.2s ease; }
  .bot-link:hover { color: var(--c-accent-bright); }

  @media (max-width: 900px) { .bot-grid { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; } }
</style>
