---
const items = [
  { label: 'Bank-grade encryption', icon: 'lock' },
  { label: 'FCA authorised', icon: 'check' },
  { label: 'ISO 27001 certified', icon: 'badge' },
  { label: 'Funds stay at your broker', icon: 'vault' },
];

const icons: Record<string, string> = {
  lock: '<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>',
  check: '<circle cx="12" cy="12" r="9"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/>',
  badge: '<path d="M12 3l2.4 1.7 2.9-.2 1 2.8 2.3 1.8-1 2.8.6 2.9-2.6 1.3-1.5 2.5-2.9-.5L12 21l-2.7-.6-2.9.5-1.5-2.5L2.3 17l.6-2.9-1-2.8 2.3-1.8 1-2.8 2.9.2z"/>',
  vault: '<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="12" cy="12" r="3.5"/><path d="M12 4v2M12 18v2"/>',
};
---

<section class="trustbar">
  <div class="container">
    <ul class="trust-grid reveal">
      {items.map((it) => (
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[it.icon]} />
          <span>{it.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trustbar { padding-block: 1.5rem; border-block: 1px solid var(--c-border); background: rgba(0,0,0,0.15); }
  .trust-grid { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1.25rem 2rem; }
  .trust-grid li { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--c-text-muted); font-family: var(--font-display); font-size: 0.92rem; font-weight: 500; }
  .trust-grid svg { width: 20px; height: 20px; color: var(--c-accent-bright); flex: none; }

  @media (max-width: 760px) { .trust-grid { justify-content: center; } }
</style>
