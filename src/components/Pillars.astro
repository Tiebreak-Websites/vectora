---
const pillars = [
  {
    n: '01',
    title: 'Proven Reliability',
    body: 'Subjected to 1.5 years in beta testing across extreme market volatility cycles to ensure capital preservation.',
    tag: 'Institutional grade',
    icon: 'shield',
  },
  {
    n: '02',
    title: 'Institutional ROI',
    body: 'Delivering 3–4% targeted monthly returns through non-correlated algorithmic arbitrage strategies.',
    tag: 'Compare performance',
    icon: 'trend',
  },
  {
    n: '03',
    title: 'Unrivaled Precision',
    body: 'Maintaining a 91.4% historical win rate by analyzing 4.2M data points per second with zero emotional bias.',
    tag: 'Quantum execution',
    icon: 'target',
  },
];

const icons: Record<string, string> = {
  shield: '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/><path d="M9.5 12l1.8 1.8L15 10"/>',
  trend: '<path d="M3 17l5-5 3 3 7-7"/><path d="M15 8h5v5"/>',
  target: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3.4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/>',
};
---

<section class="section pillars">
  <div class="container">
    <div class="pillar-grid">
      {pillars.map((p, i) => (
        <article class="card pillar reveal" style={`--reveal-delay:${i * 90}ms`}>
          <div class="pillar-head">
            <span class="picon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[p.icon]} />
            </span>
            <span class="pnum">{p.n}</span>
          </div>
          <h3>{p.title}</h3>
          <p>{p.body}</p>
          <span class="ptag">{p.tag}</span>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .pillars { padding-block: clamp(1rem, 3vw, 2rem) clamp(3rem, 6vw, 4.5rem); }
  .pillar-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .pillar { display: flex; flex-direction: column; }
  .pillar-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.1rem; }
  .picon {
    display: inline-flex; width: 46px; height: 46px;
    align-items: center; justify-content: center;
    border-radius: 12px; color: var(--c-accent-bright);
    background: var(--c-accent-soft); border: 1px solid var(--glass-border);
  }
  .picon svg { width: 23px; height: 23px; }
  .pnum { font-family: var(--font-display); font-weight: 700; font-size: 1.3rem; color: var(--c-text-dim); }
  .pillar h3 { font-size: 1.3rem; margin-bottom: 0.55rem; }
  .pillar p { color: var(--c-text-muted); font-size: 0.97rem; flex: 1; }
  .ptag {
    margin-top: 1.3rem; align-self: flex-start;
    font-family: var(--font-display); font-size: 0.72rem; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--c-accent-bright);
  }

  @media (max-width: 900px) { .pillar-grid { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; } }
</style>
