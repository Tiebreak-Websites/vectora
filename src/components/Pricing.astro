---
const plans = [
  {
    name: 'Starter',
    price: '$0',
    period: '/ 14-day trial',
    desc: 'Try one bot on a live demo account. No card required.',
    cta: 'Start free trial',
    featured: false,
    features: ['1 active bot', 'Demo / paper trading', 'Real-time dashboard', 'Community support'],
  },
  {
    name: 'Professional',
    price: '$149',
    period: '/ month',
    desc: 'For active traders ready to automate real capital.',
    cta: 'Get started',
    featured: true,
    features: ['Up to 5 active bots', 'Live trading · all assets', 'Adaptive risk controls', 'Backtesting suite', 'Priority support'],
  },
  {
    name: 'Institutional',
    price: 'Custom',
    period: '',
    desc: 'For funds and prop desks running at scale.',
    cta: 'Talk to sales',
    featured: false,
    features: ['Unlimited bots & sub-accounts', 'Dedicated infrastructure', 'Custom strategy development', 'SLA & dedicated manager'],
  },
];
---

<section class="section pricing" id="packages">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Our Packages</span>
      <h2>Plans that <span class="text-accent">scale with you</span></h2>
      <p>Start free, upgrade when you're ready to go live. Cancel anytime — no lock-in, no performance fees.</p>
    </div>

    <div class="plan-grid">
      {plans.map((p, i) => (
        <article class={`plan reveal ${p.featured ? 'featured' : ''}`} style={`--reveal-delay:${i * 90}ms`}>
          {p.featured && <span class="plan-badge">Most popular</span>}
          <h3>{p.name}</h3>
          <p class="plan-desc">{p.desc}</p>
          <div class="plan-price"><span class="amount">{p.price}</span><span class="period">{p.period}</span></div>
          <a href="#support" class={`btn ${p.featured ? 'btn-primary' : 'btn-ghost'} plan-cta`}>{p.cta}</a>
          <ul class="plan-features">
            {p.features.map((f) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                {f}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .plan-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; align-items: start; }
  .plan {
    position: relative; display: flex; flex-direction: column;
    padding: 2rem 1.75rem;
    background: var(--grad-panel); border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg); backdrop-filter: blur(var(--glass-blur));
  }
  .plan.featured { border-color: rgba(18,201,125,0.45); box-shadow: var(--glow-accent); transform: translateY(-8px); }
  .plan-badge {
    position: absolute; top: -12px; left: 50%; transform: translateX(-50%);
    font-family: var(--font-display); font-size: 0.7rem; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase;
    padding: 0.35rem 0.8rem; border-radius: var(--radius-pill);
    color: #062A1B; background: var(--grad-accent); white-space: nowrap;
  }
  .plan h3 { font-size: 1.35rem; }
  .plan-desc { color: var(--c-text-muted); font-size: 0.92rem; margin-top: 0.4rem; min-height: 2.6em; }
  .plan-price { display: flex; align-items: baseline; gap: 0.4rem; margin: 1.1rem 0 1.4rem; }
  .amount { font-family: var(--font-display); font-weight: 800; font-size: 2.6rem; letter-spacing: -0.03em; color: var(--c-text); }
  .period { color: var(--c-text-dim); font-size: 0.9rem; }
  .plan-cta { width: 100%; }
  .plan-features { margin: 1.5rem 0 0; display: grid; gap: 0.7rem; }
  .plan-features li { display: flex; gap: 0.6rem; align-items: flex-start; color: var(--c-text-muted); font-size: 0.94rem; }
  .plan-features svg { width: 18px; height: 18px; color: var(--c-accent-bright); flex: none; margin-top: 2px; }

  @media (max-width: 900px) { .plan-grid { grid-template-columns: 1fr; max-width: 420px; margin-inline: auto; } .plan.featured { transform: none; } }
</style>
