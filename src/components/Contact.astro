---
import ContactForm from "./ContactForm.astro";
import { gradText } from "../helpers";

const { supportPage } = Astro.props;

const contactOptions = supportPage.acf.options;

const options = [
  {
    title: contactOptions[0].title,
    body: contactOptions[0].body,
    terms: contactOptions[0].terms,
    cta: contactOptions[0].cta,
    href: contactOptions[0].href,
    icon: contactOptions[0].icon,
  },
  {
    title: contactOptions[1].title,
    body: contactOptions[1].body,
    terms: contactOptions[1].terms,
    cta: contactOptions[1].cta,
    href: contactOptions[1].href,
    icon: contactOptions[1].icon,
  },
  {
    title: contactOptions[2].title,
    body: contactOptions[2].body,
    terms: contactOptions[2].terms,
    cta: contactOptions[2].cta,
    href: contactOptions[2].href,
    icon: contactOptions[2].icon,
  },
];
---

<section class="section page-hero">
  <div class="container">
    <h1 class="reveal" set:html={gradText(supportPage.acf.headline)} />
    <p
      class="lede reveal"
      style="--reveal-delay:120ms"
      set:html={supportPage.acf.text}
    />
  </div>
</section>

<section class="section support-sec" id="support">
  <div class="container">
    <div class="support-grid">
      <aside class="opt-col">
        {
          options.map((o, i) => (
            <div
              class:list={[
                "opt card hoverable spot reveal",
                { "opt-split": o.terms },
              ]}
              style={`--reveal-delay:${i * 90}ms`}
            >
              <span class="opt-icon">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={o.icon}
                />
              </span>
              <span class="opt-main">
                <h3>{o.title}</h3>
                <p>
                  {o.body}
                  {o.terms && (
                    <>
                      {" "}
                      <a href="#" class="opt-terms">
                        Terms of Service
                      </a>{" "}
                      apply.
                    </>
                  )}
                </p>
                <a href={o.href} class="opt-cta">
                  {o.cta}{" "}
                  <span class="arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              </span>
            </div>
          ))
        }
      </aside>

      <ContactForm
        title={supportPage.acf.form.title}
        text={supportPage.acf.form.text}
        emailTo={supportPage.acf.form.email_to}
      />
    </div>
  </div>
</section>

<style is:global>
  .support-sec {
    padding-top: clamp(1rem, 3vw, 2rem);
  }
  .support-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: start;
  }

  /* Vertical option tiles */
  .opt-col {
    display: grid;
    gap: 1.1rem;
  }
  .opt {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
    padding: 1.5rem;
  }
  .opt-icon {
    flex: none;
    display: inline-flex;
    width: 46px;
    height: 46px;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    color: var(--text-2);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--line-strong);
  }
  .opt-icon svg {
    width: 22px;
    height: 22px;
  }
  .opt-main {
    display: flex;
    flex-direction: column;
  }
  .opt h3 {
    font-size: 1.12rem;
  }
  .opt p {
    color: var(--text-3);
    font-size: 0.92rem;
    margin-top: 0.4rem;
  }
  .opt-terms {
    color: var(--text-3);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .opt-terms:hover {
    color: var(--green-bright);
  }
  .opt-cta {
    margin-top: 0.8rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--green-bright);
  }
  /* Stretched link — the CTA anchor covers the whole tile, except on a card
     whose body carries its own link, where the two would compete for clicks. */
  .opt-cta::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }
  .opt-split .opt-cta::after {
    content: none;
  }
  .opt-cta .arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }
  .opt:hover .opt-cta .arrow {
    transform: translateX(3px);
  }

  /* Form */
  .contact-form {
    display: grid;
    gap: 1.1rem;
    padding: clamp(1.75rem, 4vw, 2.5rem);
    border-radius: var(--radius-lg);
    box-shadow: 0 0 70px -30px var(--green-glow);
  }
  .contact-form h2 {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
  }
  .form-sub {
    color: var(--text-3);
    font-size: 0.95rem;
    margin-top: -0.4rem;
  }
  .row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }
  .field {
    display: grid;
    gap: 0.4rem;
  }
  label {
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text);
  }
  input,
  textarea {
    width: 100%;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    padding: 0.8rem 0.9rem;
    color: var(--text);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  input::placeholder,
  textarea::placeholder {
    color: var(--text-4);
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--green-bright);
    box-shadow: 0 0 0 3px rgba(23, 212, 139, 0.15);
  }
  textarea {
    resize: vertical;
  }
  .field.invalid input,
  .field.invalid textarea {
    border-color: #e4685f;
  }
  .err {
    color: #f08d84;
    font-size: 0.8rem;
    min-height: 1em;
  }
  .form-submit {
    width: 100%;
    margin-top: 0.25rem;
  }
  .form-status {
    font-size: 0.9rem;
    text-align: center;
    min-height: 1.2em;
  }
  .form-status.ok {
    color: var(--green-bright);
  }
  .form-status.bad {
    color: #f08d84;
  }
  .form-fine {
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--text-4);
  }
  .form-fine a {
    color: var(--text-3);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .form-fine a:hover {
    color: var(--green-bright);
  }

  @media (max-width: 900px) {
    .support-grid {
      grid-template-columns: 1fr;
    }
    .opt-col {
      max-width: 560px;
    }
  }
  @media (max-width: 560px) {
    .row-2 {
      grid-template-columns: 1fr;
    }
  }
</style>
