---
// To deliver email, set FORM_ENDPOINT to a form backend URL (Formspree,
// Basin, your own API). Left blank, the form validates and shows success
// for demo purposes without sending.
const FORM_ENDPOINT = '';
---

<section class="section contact" id="support">
  <div class="container contact-grid">
    <div class="contact-intro reveal">
      <span class="eyebrow">Support</span>
      <h2>Get a call <span class="text-accent">from our team</span></h2>
      <p>Start your free 14-day trial or talk to us about a custom setup. Tell us how you trade and we'll point you to the right bot.</p>

      <ul class="contact-points">
        <li><span aria-hidden="true">✓</span> No credit card required to start</li>
        <li><span aria-hidden="true">✓</span> Live demo account in minutes</li>
        <li><span aria-hidden="true">✓</span> Cancel anytime, no lock-in</li>
      </ul>

      <p class="contact-mail">Prefer email? <a href="mailto:hello@vectora.io">hello@vectora.io</a></p>
    </div>

    <form class="contact-form card reveal" id="contact-form" novalidate data-endpoint={FORM_ENDPOINT}>
      <div class="field">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" autocomplete="name" required placeholder="Alex Trader" />
        <span class="err" data-for="name"></span>
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required placeholder="you@example.com" />
        <span class="err" data-for="email"></span>
      </div>
      <div class="field">
        <label for="experience">Experience</label>
        <select id="experience" name="experience">
          <option value="">Select one…</option>
          <option>New to trading</option>
          <option>Trading 1–3 years</option>
          <option>Experienced / 3+ years</option>
          <option>Fund / prop desk</option>
        </select>
      </div>
      <div class="field">
        <label for="message">What do you want to automate?</label>
        <textarea id="message" name="message" rows="4" required placeholder="e.g. I trade crypto on Binance and want to run Arbitrage Core…"></textarea>
        <span class="err" data-for="message"></span>
      </div>
      <button type="submit" class="btn btn-primary btn-lg form-submit">Request a call</button>
      <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<style>
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 4.5rem); align-items: start; }
  .contact-intro h2 { font-size: clamp(2rem, 4vw, 2.9rem); margin-top: 1rem; }
  .contact-intro > p { color: var(--c-text-muted); margin-top: 1.1rem; font-size: 1.05rem; }
  .contact-points { margin: 1.5rem 0; display: grid; gap: 0.6rem; }
  .contact-points li { display: flex; gap: 0.6rem; color: var(--c-text-muted); }
  .contact-points span { color: var(--c-accent-bright); font-weight: 700; }
  .contact-mail { color: var(--c-text-muted); }
  .contact-mail a { color: var(--c-accent-bright); border-bottom: 1px solid transparent; }
  .contact-mail a:hover { border-bottom-color: currentColor; }

  .contact-form { display: grid; gap: 1.1rem; padding: clamp(1.5rem, 3vw, 2.2rem); }
  .field { display: grid; gap: 0.4rem; }
  label { font-family: var(--font-display); font-size: 0.88rem; font-weight: 500; color: var(--c-text); }
  input, select, textarea {
    width: 100%; background: rgba(0,0,0,0.25);
    border: 1px solid var(--c-border-strong); border-radius: var(--radius-sm);
    padding: 0.8rem 0.9rem; color: var(--c-text);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  input::placeholder, textarea::placeholder { color: var(--c-text-dim); }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--c-accent-bright); box-shadow: 0 0 0 3px rgba(18,201,125,0.15); }
  textarea { resize: vertical; }
  select { appearance: none; cursor: pointer; }
  .field.invalid input, .field.invalid textarea { border-color: #ef6a85; }
  .err { color: #f0889d; font-size: 0.8rem; min-height: 1em; }
  .form-submit { width: 100%; margin-top: 0.25rem; }
  .form-status { font-size: 0.9rem; text-align: center; min-height: 1.2em; }
  .form-status.ok { color: var(--c-accent-bright); }
  .form-status.bad { color: #f0889d; }

  @media (max-width: 900px) { .contact-grid { grid-template-columns: 1fr; } }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('form-status');

  if (form && statusEl) {
    const setError = (name: string, msg: string) => {
      const field = form.querySelector(`[name="${name}"]`)?.closest('.field');
      const err = form.querySelector(`.err[data-for="${name}"]`);
      field?.classList.toggle('invalid', Boolean(msg));
      if (err) err.textContent = msg;
    };

    const validate = () => {
      let ok = true;
      const data = new FormData(form);
      const name = (data.get('name') as string)?.trim();
      const email = (data.get('email') as string)?.trim();
      const message = (data.get('message') as string)?.trim();

      setError('name', name ? '' : 'Please enter your name.');
      if (!name) ok = false;
      const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email || '');
      setError('email', emailOk ? '' : 'Please enter a valid email.');
      if (!emailOk) ok = false;
      setError('message', message ? '' : 'Tell us a little about your goals.');
      if (!message) ok = false;
      return ok;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      statusEl.textContent = '';
      statusEl.className = 'form-status';
      if (!validate()) return;

      const btn = form.querySelector<HTMLButtonElement>('.form-submit');
      const endpoint = form.dataset.endpoint;
      if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }

      try {
        if (endpoint) {
          const res = await fetch(endpoint, { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(form) });
          if (!res.ok) throw new Error('Request failed');
        } else {
          await new Promise((r) => setTimeout(r, 700));
        }
        form.reset();
        statusEl.textContent = "Thanks! We'll be in touch within one business day.";
        statusEl.classList.add('ok');
      } catch {
        statusEl.textContent = 'Something went wrong. Please email hello@vectora.io.';
        statusEl.classList.add('bad');
      } finally {
        if (btn) { btn.disabled = false; btn.textContent = 'Request a call'; }
      }
    });

    form.querySelectorAll('input, textarea').forEach((el) => {
      el.addEventListener('input', () => {
        const name = (el as HTMLInputElement).name;
        const field = el.closest('.field');
        if (field?.classList.contains('invalid')) setError(name, '');
      });
    });
  }
</script>
