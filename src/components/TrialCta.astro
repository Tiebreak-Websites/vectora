---
const points = [
  '7-day trial — see the bot work before you commit',
  'No credit card needed to start',
  'Cancel anytime, no lock-in',
];
---

<section class="section trial">
  <div class="container trial-box grad-border spot reveal">
    <div class="trial-copy">
      <h2>Try it for <span class="grad-text">7 days</span></h2>
      <p>
        Watch a bot trade before you commit. Payment details are only needed
        if you continue after the trial.
      </p>
      <ul class="points">
        {points.map((p) => (
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>{p}</li>
        ))}
      </ul>
    </div>
    <div class="trial-actions">
      <a href="/signup" class="btn btn-primary btn-lg">Start your 7-day trial <span class="arrow" aria-hidden="true">→</span></a>
      <a href="/support" class="btn btn-outline btn-lg">Get a call from our team</a>
    </div>
  </div>
</section>

<style>
  .trial-box {
    display: grid; grid-template-columns: 1.4fr 1fr;
    gap: clamp(1.5rem, 5vw, 3.5rem); align-items: center;
    padding: clamp(2rem, 5vw, 3.25rem);
    border-radius: var(--radius-lg);
    position: relative;
    box-shadow: 0 0 70px -28px var(--green-glow);
  }
  .trial-copy h2 { font-size: clamp(1.8rem, 4vw, 2.5rem); }
  .trial-copy > p { color: var(--text-3); margin-top: 1rem; max-width: 44ch; }
  .points { margin-top: 1.4rem; display: grid; gap: 0.6rem; }
  .points li { display: flex; gap: 0.6rem; align-items: flex-start; color: var(--text-2); font-size: 0.95rem; }
  .points svg { width: 17px; height: 17px; color: var(--green-bright); flex: none; margin-top: 3px; }

  .trial-actions { display: grid; gap: 0.8rem; justify-items: stretch; position: relative; }
  .trial-actions .btn { width: 100%; }

  @media (max-width: 820px) { .trial-box { grid-template-columns: 1fr; } .trial-actions { max-width: 380px; } }
</style>
