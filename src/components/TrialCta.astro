---
const points = [
  'See the bot work before you commit',
  'No credit card needed to start',
  'Cancel anytime, no lock-in',
];
---

<section class="section trial">
  <div class="container trial-box grad-border spot reveal">
    <h2>Try it for <span class="grad-text">7 days</span></h2>
    <p>
      Watch a bot trade before you commit. Payment details are only needed
      if you continue after the trial.
    </p>
    <ul class="points">
      {points.map((p) => (
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>{p}</li>
      ))}
    </ul>
    <div class="trial-actions">
      <a href="/signup" class="btn btn-primary btn-lg">Start your 7-day trial <span class="arrow" aria-hidden="true">→</span></a>
      <a href="/support" class="btn btn-outline btn-lg">Get a call from our team</a>
    </div>
  </div>
</section>

<style>
  .trial-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(2.5rem, 6vw, 4rem) clamp(1.5rem, 5vw, 3.25rem);
    border-radius: var(--radius-lg);
    position: relative;
    box-shadow: 0 0 70px -28px var(--green-glow);
  }
  .trial-box h2 { font-size: clamp(1.9rem, 4.2vw, 2.8rem); }
  .trial-box > p { color: var(--text-3); margin-top: 1rem; max-width: 48ch; }

  .points {
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: 0.75rem 2rem;
    margin-top: 1.5rem;
  }
  .points li { display: inline-flex; gap: 0.55rem; align-items: center; color: var(--text-2); font-size: 0.95rem; }
  .points svg { width: 17px; height: 17px; color: var(--green-bright); flex: none; }

  .trial-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.85rem; margin-top: 2rem; }

  @media (max-width: 560px) {
    .points { flex-direction: column; align-items: center; gap: 0.6rem; }
    .trial-actions { width: 100%; }
    .trial-actions .btn { width: 100%; }
  }
</style>
