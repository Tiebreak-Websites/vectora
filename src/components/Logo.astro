---
// Vectora brand lockup. variant="white" = white wordmark for dark
// backgrounds (default); variant="dark" = dark-ink wordmark for light.
const { height = 30, variant = 'white' } = Astro.props;
const src = variant === 'dark' ? '/vectora-logo-dark.svg' : '/vectora-logo-white.svg';
---

<img
  src={src}
  alt="Vectora"
  class="logo"
  height={height}
  width={Math.round((height * 1782) / 472)}
  style={`--h:${height}px`}
  decoding="async"
/>

<style>
  .logo {
    height: var(--h);
    width: auto;
    display: block;
    user-select: none;
  }
</style>
