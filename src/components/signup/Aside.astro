---
import Logo from "../Logo.astro";
import { gradText } from "../../helpers";

const { page } = Astro.props;

const perks = [
  "Three specialist algos — gold, Bitcoin, Nasdaq",
  "Every trade visible in your own account",
  "60-day refund period",
  "1 year of algo access with every package",
];
---

<aside class="auth-side" aria-hidden="true">
  <a href="/" class="side-logo" aria-label="Vectora home"
    ><Logo height={30} /></a
  >
  <h2 set:html={gradText(page.acf.title)} />
  <ul class="side-perks">
    {
      page.acf.list.map((p: any) => (
        <li>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20 6L9 17l-5-5" />
          </svg>
          {p.text}
        </li>
      ))
    }
  </ul>
  <div class="side-stats">
    {
      page.acf.stats.map((s: any) => (
        <div>
          <>
            <span class="ss-v">{s.v}</span>
            <span class="ss-k">{s.k}</span>
          </>
        </div>
      ))
    }
  </div>
</aside>
