---
// Bot facts from the official copy: instruments, Monthly Average ROI, Live status.
const bots = [
  {
    name: 'MIRA', instrument: 'Gold (XAU)', roi: '3–5%',
    spark: 'M2 30 L16 26 L30 28 L44 22 L58 24 L72 18 L86 20 L100 14 L114 16 L128 10',
  },
  {
    name: 'AXON', instrument: 'Bitcoin (BTC)', roi: '5–7%',
    spark: 'M2 32 L16 24 L30 27 L44 16 L58 21 L72 12 L86 17 L100 8 L114 12 L128 4',
  },
  {
    name: 'KAIRO', instrument: 'USD/JPY', roi: '4–6%',
    spark: 'M2 28 L16 24 L30 26 L44 20 L58 23 L72 17 L86 19 L100 13 L114 15 L128 8',
  },
];

const ticker = [
  { a: 'MIRA', b: 'GOLD (XAU)', c: '3–5% / mo' },
  { a: 'AXON', b: 'BITCOIN (BTC)', c: '5–7% / mo' },
  { a: 'KAIRO', b: 'USD/JPY', c: '4–6% / mo' },
  { a: 'ALL BOTS', b: 'OVERALL WIN RATE', c: '92%' },
  { a: 'ALL BOTS', b: 'OVERALL DRAWDOWN', c: '1–2%' },
  { a: 'ENGINE', b: 'STATUS', c: '24/7' },
];
---

<section class="hero" aria-labelledby="hero-title">
  <canvas id="hero-canvas" class="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-fade" aria-hidden="true"></div>

  <div class="container hero-copy">
    <p class="eyebrow reveal">Live portfolio bots</p>

    <h1 id="hero-title" class="reveal" style="--reveal-delay:80ms">
      Your guardian layer for<br /><span class="grad-text">clearer market decisions.</span>
    </h1>

    <p class="lede reveal" style="--reveal-delay:160ms">
      Vectora watches selected market conditions, checks risk around each
      setup, and helps you see the trade more clearly before you commit.
      You choose the broker setup, you choose the package, and the final
      decision stays yours.
    </p>

    <div class="hero-cta reveal" style="--reveal-delay:240ms">
      <a href="/packages" class="btn btn-primary btn-lg">View packages <span class="arrow" aria-hidden="true">→</span></a>
      <a href="/support" class="btn btn-outline btn-lg">Get a call from our team</a>
    </div>
  </div>

  <div class="container">
    <div class="hero-bots" aria-label="The three Vectora bots">
      {bots.map((b, i) => (
        <a href="/bots" class="hb card hoverable spot reveal" style={`--reveal-delay:${320 + i * 90}ms`}>
          <div class="hb-top">
            <span class="hb-name">{b.name}</span>
            <span class="hb-live"><span class="lp"></span> Live</span>
          </div>
          <span class="hb-market">{b.instrument}</span>
          <svg class="spark" viewBox="0 0 130 36" aria-hidden="true" preserveAspectRatio="none">
            <path d={b.spark} fill="none" stroke="url(#herospark)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <div class="hb-foot">
            <div>
              <span class="hb-roi">{b.roi}</span>
              <span class="hb-roi-k figure-label">Monthly Average ROI</span>
            </div>
            <span class="hb-arrow" aria-hidden="true">→</span>
          </div>
        </a>
      ))}
    </div>

    <svg width="0" height="0" aria-hidden="true">
      <defs>
        <linearGradient id="herospark" x1="0" y1="1" x2="1" y2="0">
          <stop offset="0" stop-color="#09A165" />
          <stop offset="1" stop-color="#17D48B" />
        </linearGradient>
      </defs>
    </svg>
  </div>
</section>

<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    {[0, 1, 2, 3].map(() => (
      ticker.map((t) => (
        <span class="tick">
          <span class="t-a">{t.a}</span>
          <span class="t-b">{t.b}</span>
          <span class="t-c">{t.c}</span>
        </span>
      ))
    ))}
  </div>
</div>

<style>
  .hero { padding-block: clamp(4rem, 10vw, 7.5rem); position: relative; overflow: hidden; }
  .hero-canvas {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    opacity: 0.5;
    pointer-events: none;
  }
  .hero-fade {
    position: absolute; inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, var(--bg) 0%, transparent 22%, transparent 78%, var(--bg) 100%),
      linear-gradient(180deg, rgba(14, 21, 18, 0.5), transparent 30%, transparent 62%, var(--bg));
  }
  .hero-copy {
    position: relative;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  h1 {
    font-size: clamp(2.5rem, 5.6vw, 4.2rem);
    font-weight: 600;
  }
  .lede {
    color: var(--text-2);
    font-size: 1.14rem;
    max-width: 62ch;
    margin-top: 1.4rem;
  }
  .hero-cta { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.85rem; margin-top: 2.3rem; }

  /* Bots — three interactive mini-cards under the CTAs */
  .hero-bots {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.1rem;
    margin-top: clamp(2.75rem, 6vw, 4.25rem);
  }
  .hb {
    display: flex; flex-direction: column;
    padding: 1.35rem 1.45rem 1.25rem;
    background: rgba(18, 26, 22, 0.85);
    backdrop-filter: blur(8px);
    text-align: left;
  }
  .hb-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .hb-name { font-family: var(--font-display); font-weight: 600; font-size: 1.25rem; color: var(--text); }
  .hb-live {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--green-bright);
  }
  .lp { width: 7px; height: 7px; border-radius: 50%; background: var(--green-bright); animation: lpulse 1.8s infinite; }
  @keyframes lpulse { 0% { box-shadow: 0 0 0 0 rgba(23, 212, 139, 0.5); } 100% { box-shadow: 0 0 0 8px rgba(23, 212, 139, 0); } }
  .hb-market { font-family: var(--font-mono); font-size: 0.76rem; color: var(--text-3); margin-top: 0.25rem; letter-spacing: 0.04em; }
  .hb .spark { width: 100%; height: 34px; margin-top: 1rem; opacity: 0.9; }
  .hb-foot {
    display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem;
    margin-top: 1rem; padding-top: 0.9rem;
    border-top: 1px solid var(--line);
  }
  .hb-roi { display: block; font-family: var(--font-display); font-weight: 600; font-size: 1.45rem; letter-spacing: -0.02em; color: var(--green-bright); font-variant-numeric: tabular-nums; }
  .hb-roi-k { display: block; margin-top: 0.15rem; }
  .hb-arrow { color: var(--text-4); font-size: 1.1rem; transition: transform 0.2s ease, color 0.2s ease; }
  .hb:hover .hb-arrow { transform: translateX(3px); color: var(--green-bright); }

  @media (max-width: 860px) {
    .hero-bots { grid-template-columns: 1fr; max-width: 420px; margin-inline: auto; margin-top: 2.5rem; }
  }

  /* Ticker */
  .marquee { border-block: 1px solid var(--line); background: var(--bg-2); }
  .tick { display: inline-flex; align-items: baseline; gap: 0.7rem; margin-right: 3rem; font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.06em; white-space: nowrap; }
  .t-a { color: var(--text); font-weight: 500; }
  .t-b { color: var(--text-4); }
  .t-c { color: var(--green-bright); }
</style>

<script>
  // Animated market-line canvas — decorative, deterministic, pauses for
  // reduced-motion. Re-inits on client-side navigation.
  const initHeroCanvas = () => {
    const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
    if (!canvas || canvas.dataset.init) return;
    canvas.dataset.init = 'true';
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let w = 0, h = 0, dpr = 1;
    let raf = 0;

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = rect.width; h = rect.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize();
    window.addEventListener('resize', resize, { passive: true });

    // Deterministic pseudo-random walk
    let seed = 7;
    const rand = () => {
      seed = (seed * 16807) % 2147483647;
      return (seed - 1) / 2147483646;
    };
    const N = 160;
    const pts: number[] = [];
    let v = 0.5;
    for (let i = 0; i < N; i++) {
      v += (rand() - 0.48) * 0.06;
      v = Math.max(0.12, Math.min(0.88, v));
      pts.push(v);
    }

    let t = 0;
    const draw = () => {
      ctx.clearRect(0, 0, w, h);

      // Faint grid
      ctx.strokeStyle = 'rgba(255,255,255,0.05)';
      ctx.lineWidth = 1;
      const gs = 56;
      for (let x = (t * -18) % gs; x < w; x += gs) {
        ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke();
      }
      for (let y = 0; y < h; y += gs) {
        ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke();
      }

      // Market line
      const step = w / (N - 8);
      const off = (t * 18) % step;
      const yFor = (i: number) => h * (0.18 + pts[i % N] * 0.64);
      const shift = Math.floor((t * 18) / step);

      ctx.beginPath();
      for (let i = 0; i < N; i++) {
        const x = i * step - off;
        const y = yFor(i + shift);
        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      }
      // Fill below line
      const grad = ctx.createLinearGradient(0, 0, 0, h);
      grad.addColorStop(0, 'rgba(9, 161, 101, 0.16)');
      grad.addColorStop(1, 'rgba(9, 161, 101, 0)');
      ctx.save();
      ctx.lineTo(w + 20, h + 20); ctx.lineTo(-20, h + 20); ctx.closePath();
      ctx.fillStyle = grad;
      ctx.fill();
      ctx.restore();

      // Stroke on top
      ctx.beginPath();
      for (let i = 0; i < N; i++) {
        const x = i * step - off;
        const y = yFor(i + shift);
        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      }
      ctx.strokeStyle = 'rgba(23, 212, 139, 0.5)';
      ctx.lineWidth = 1.6;
      ctx.shadowColor = 'rgba(23, 212, 139, 0.45)';
      ctx.shadowBlur = 10;
      ctx.stroke();
      ctx.shadowBlur = 0;

      if (!reduced) {
        t += 0.016;
        raf = requestAnimationFrame(draw);
      }
    };
    draw();

    // Stop the loop when this canvas is removed by a page swap.
    document.addEventListener('astro:before-swap', () => cancelAnimationFrame(raf), { once: true });
  };

  document.addEventListener('astro:page-load', initHeroCanvas);
</script>
