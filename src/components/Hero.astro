---
const stats = [
  { v: '4–5%', k: 'Avg. monthly return' },
  { v: '92%', k: 'Win rate' },
  { v: '1–2%', k: 'Max drawdown' },
  { v: '548', k: 'Days live + backtested' },
];

const bots = [
  { name: 'Mira', market: 'Gold · XAU/USD', roi: '3–5% / mo' },
  { name: 'Axon', market: 'Bitcoin · BTC/USD', roi: '5–7% / mo' },
  { name: 'Kairo', market: 'Forex · USD/JPY', roi: '4–6% / mo' },
];

const ticker = [
  { a: 'MIRA', b: 'XAU/USD', c: '3–5% / mo' },
  { a: 'AXON', b: 'BTC/USD', c: '5–7% / mo' },
  { a: 'KAIRO', b: 'USD/JPY', c: '4–6% / mo' },
  { a: 'ALL BOTS', b: 'WIN RATE', c: '92%' },
  { a: 'ALL BOTS', b: 'DRAWDOWN', c: '1–2%' },
  { a: 'ENGINE', b: 'EXECUTION', c: '24/7' },
];
---

<section class="hero" aria-labelledby="hero-title">
  <canvas id="hero-canvas" class="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-fade" aria-hidden="true"></div>

  <div class="container hero-copy">
    <h1 id="hero-title" class="reveal">
      Trading discipline,<br /><span class="grad-text">automated.</span>
    </h1>

    <p class="lede reveal" style="--reveal-delay:120ms">
      Vectora runs three specialist trading bots — on gold, Bitcoin and
      USD/JPY. Rules-based execution around the clock, with every trade
      visible in your account.
    </p>

    <div class="hero-cta reveal" style="--reveal-delay:220ms">
      <a href="/packages" class="btn btn-primary btn-lg">View packages <span class="arrow" aria-hidden="true">→</span></a>
      <a href="/support" class="btn btn-outline btn-lg">Talk to our team</a>
    </div>
  </div>

  <div class="container">
    <aside class="hero-card card spot reveal" style="--reveal-delay:300ms" aria-label="The three Vectora bots">
      <div class="hc-top">
        <span class="hc-label">The bots</span>
        <span class="hc-live"><span class="lp"></span> Running</span>
      </div>
      <ul class="hc-grid">
        {bots.map((b) => (
          <li>
            <span class="hc-name">{b.name}</span>
            <span class="hc-market">{b.market}</span>
            <span class="hc-roi">{b.roi}</span>
          </li>
        ))}
      </ul>
      <p class="hc-note">Target monthly return ranges. Live trading plus 1.5 years of backtesting.</p>
    </aside>

    <ul class="hero-stats reveal" style="--reveal-delay:380ms">
      {stats.map((s) => (
        <li>
          <span class="hs-v figure">{s.v}</span>
          <span class="hs-k figure-label">{s.k}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    {[0, 1, 2, 3].map(() => (
      ticker.map((t) => (
        <span class="tick">
          <span class="t-a">{t.a}</span>
          <span class="t-b">{t.b}</span>
          <span class="t-c">{t.c}</span>
        </span>
      ))
    ))}
  </div>
</div>

<style>
  .hero { padding-block: clamp(3.5rem, 8vw, 6rem) clamp(3rem, 6vw, 4.5rem); position: relative; overflow: hidden; }
  .hero-canvas {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    opacity: 0.5;
    pointer-events: none;
  }
  .hero-fade {
    position: absolute; inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, var(--bg) 0%, transparent 22%, transparent 78%, var(--bg) 100%),
      linear-gradient(180deg, rgba(19, 28, 24, 0.5), transparent 30%, transparent 62%, var(--bg));
  }
  .hero-copy, .hero-stats, .hero-card { position: relative; }

  .hero-copy {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  h1 {
    font-size: clamp(2.7rem, 6.2vw, 4.6rem);
    font-weight: 600;
  }
  .lede {
    color: var(--text-2);
    font-size: 1.16rem;
    max-width: 56ch;
    margin-top: 1.4rem;
  }
  .hero-cta { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.85rem; margin-top: 2.3rem; }

  /* Bots strip — wide, centered */
  .hero-card {
    margin-top: clamp(2.75rem, 6vw, 4.25rem);
    padding: 1.4rem 1.75rem 1.2rem;
    background: rgba(23, 34, 29, 0.82);
    backdrop-filter: blur(8px);
  }
  .hc-top { display: flex; align-items: center; justify-content: space-between; }
  .hc-label {
    font-family: var(--font-mono); font-size: 0.7rem; font-weight: 500;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-4);
  }
  .hc-live {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--green-bright);
  }
  .lp { width: 7px; height: 7px; border-radius: 50%; background: var(--green-bright); animation: lpulse 1.8s infinite; }
  @keyframes lpulse { 0% { box-shadow: 0 0 0 0 rgba(23, 212, 139, 0.5); } 100% { box-shadow: 0 0 0 8px rgba(23, 212, 139, 0); } }

  .hc-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .hc-grid li {
    display: flex; flex-direction: column; gap: 0.2rem;
    padding-top: 1.1rem;
  }
  .hc-grid li + li { border-left: 1px solid var(--line); padding-left: 1.5rem; }
  .hc-name { font-family: var(--font-display); font-weight: 600; font-size: 1.15rem; color: var(--text); }
  .hc-market { font-size: 0.82rem; color: var(--text-3); }
  .hc-roi { font-family: var(--font-mono); font-size: 0.95rem; font-weight: 500; color: var(--green-bright); margin-top: 0.35rem; }
  .hc-note { margin-top: 1.1rem; padding-top: 0.9rem; border-top: 1px solid var(--line); font-size: 0.78rem; color: var(--text-4); text-align: center; }

  /* Stats strip */
  .hero-stats {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;
    margin-top: clamp(2.25rem, 5vw, 3.25rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
    text-align: center;
  }
  .hs-v { display: block; font-size: clamp(1.6rem, 3.4vw, 2.3rem); }
  .hs-k { display: block; margin-top: 0.3rem; }

  /* Ticker */
  .marquee { border-block: 1px solid var(--line); background: var(--bg-2); }
  .tick { display: inline-flex; align-items: baseline; gap: 0.7rem; margin-right: 3rem; font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.06em; white-space: nowrap; }
  .t-a { color: var(--text); font-weight: 500; }
  .t-b { color: var(--text-4); }
  .t-c { color: var(--green-bright); }

  @media (max-width: 760px) {
    .hc-grid { grid-template-columns: 1fr; gap: 0; border-top: 0; }
    .hc-grid li { border-top: 1px solid var(--line); padding-block: 0.9rem; }
    .hc-grid li + li { border-left: 0; padding-left: 0; }
    .hero-stats { grid-template-columns: repeat(2, 1fr); gap: 1.5rem 1rem; }
  }
</style>

<script>
  // Animated market-line canvas — decorative, deterministic, pauses for
  // reduced-motion. Re-inits on client-side navigation.
  const initHeroCanvas = () => {
    const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
    if (!canvas || canvas.dataset.init) return;
    canvas.dataset.init = 'true';
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let w = 0, h = 0, dpr = 1;
    let raf = 0;

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = rect.width; h = rect.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize();
    window.addEventListener('resize', resize, { passive: true });

    // Deterministic pseudo-random walk
    let seed = 7;
    const rand = () => {
      seed = (seed * 16807) % 2147483647;
      return (seed - 1) / 2147483646;
    };
    const N = 160;
    const pts: number[] = [];
    let v = 0.5;
    for (let i = 0; i < N; i++) {
      v += (rand() - 0.48) * 0.06;
      v = Math.max(0.12, Math.min(0.88, v));
      pts.push(v);
    }

    let t = 0;
    const draw = () => {
      ctx.clearRect(0, 0, w, h);

      // Faint grid
      ctx.strokeStyle = 'rgba(255,255,255,0.05)';
      ctx.lineWidth = 1;
      const gs = 56;
      for (let x = (t * -18) % gs; x < w; x += gs) {
        ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke();
      }
      for (let y = 0; y < h; y += gs) {
        ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke();
      }

      // Market line
      const step = w / (N - 8);
      const off = (t * 18) % step;
      const yFor = (i: number) => h * (0.18 + pts[i % N] * 0.64);
      const shift = Math.floor((t * 18) / step);

      ctx.beginPath();
      for (let i = 0; i < N; i++) {
        const x = i * step - off;
        const y = yFor(i + shift);
        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      }
      // Fill below line
      const grad = ctx.createLinearGradient(0, 0, 0, h);
      grad.addColorStop(0, 'rgba(9, 161, 101, 0.16)');
      grad.addColorStop(1, 'rgba(9, 161, 101, 0)');
      ctx.save();
      ctx.lineTo(w + 20, h + 20); ctx.lineTo(-20, h + 20); ctx.closePath();
      ctx.fillStyle = grad;
      ctx.fill();
      ctx.restore();

      // Stroke on top
      ctx.beginPath();
      for (let i = 0; i < N; i++) {
        const x = i * step - off;
        const y = yFor(i + shift);
        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      }
      ctx.strokeStyle = 'rgba(23, 212, 139, 0.5)';
      ctx.lineWidth = 1.6;
      ctx.shadowColor = 'rgba(23, 212, 139, 0.45)';
      ctx.shadowBlur = 10;
      ctx.stroke();
      ctx.shadowBlur = 0;

      if (!reduced) {
        t += 0.016;
        raf = requestAnimationFrame(draw);
      }
    };
    draw();

    // Stop the loop when this canvas is removed by a page swap.
    document.addEventListener('astro:before-swap', () => cancelAnimationFrame(raf), { once: true });
  };

  document.addEventListener('astro:page-load', initHeroCanvas);
</script>
