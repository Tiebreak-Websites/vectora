---
import Layout from '../layouts/Layout.astro';
import TrialCta from '../components/TrialCta.astro';

// Confirmed figures — static, reviewed quarterly with the product team.
const overall = [
  { v: '25–32%', k: 'Yearly ROI' },
  { v: '4–5%', k: 'Avg. monthly ROI' },
  { v: '92%', k: 'Win rate, all bots' },
  { v: '1–2%', k: 'Drawdown, all bots' },
  { v: '548', k: 'Days live + backtested' },
  { v: '4,200+', k: 'Clients' },
];

const bots = [
  {
    name: 'Mira', market: 'Gold · XAU/USD',
    arch: 'Trend-following on gold with strict per-trade risk caps.',
    roi: '3–5%',
  },
  {
    name: 'Axon', market: 'Bitcoin · BTC/USD',
    arch: 'Momentum and liquidity analysis on the Bitcoin market.',
    roi: '5–7%',
  },
  {
    name: 'Kairo', market: 'Forex · USD/JPY',
    arch: 'Mean-reversion scalping within the USD/JPY corridor.',
    roi: '4–6%',
  },
];
---

<Layout title="Vectora — Results" description="Vectora performance: 25–32% yearly ROI, 4–5% average monthly ROI, 92% win rate and 1–2% drawdown across 548 days of live trading and backtesting.">
  <section class="section page-hero">
    <div class="container">
      <span class="eyebrow reveal">Results</span>
      <h1 class="reveal" style="--reveal-delay:80ms">The numbers,<br />plainly stated.</h1>
      <p class="lede reveal" style="--reveal-delay:140ms">
        Every figure on this page comes from live trading plus 1.5 years of
        backtesting. They are static, reviewed quarterly — not live tickers,
        not projections.
      </p>
    </div>
  </section>

  <section class="section overall-sec">
    <div class="container">
      <ul class="overall-grid reveal">
        {overall.map((m) => (
          <li class="ov card">
            <span class="ov-v figure">{m.v}</span>
            <span class="ov-k figure-label">{m.k}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section perbot-sec">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Per bot</span>
        <h2>Target monthly returns</h2>
      </div>

      <div class="bot-rows">
        {bots.map((b, i) => (
          <article class="row card reveal" style={`--reveal-delay:${i * 80}ms`}>
            <div class="r-id">
              <h3>{b.name}</h3>
              <span class="r-market">{b.market}</span>
            </div>
            <p class="r-arch">{b.arch}</p>
            <div class="r-roi">
              <span class="rv figure">{b.roi}</span>
              <span class="rk figure-label">Target / month</span>
            </div>
            <a href="/bots" class="btn btn-outline r-link">About this bot <span class="arrow" aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>

      <p class="note reveal" style="margin-top: 1.25rem;">
        Win rate (92%) and drawdown (1–2%) are measured across all three bots combined.
        Trading involves risk of loss; past performance does not guarantee future results.
      </p>
    </div>
  </section>

  <section class="section clients-sec">
    <div class="container clients card reveal">
      <div class="c-copy">
        <span class="eyebrow">Adoption</span>
        <h2><span class="big" data-count="4200" data-suffix="+">4,200+</span> clients</h2>
        <p>
          From first-time algo users to experienced traders, more than 4,200
          clients run Vectora bots on their accounts today — with full
          visibility of every trade.
        </p>
        <a href="/support" class="btn btn-primary btn-lg">Get a call from our team <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <ul class="c-facts">
        <li><span class="cf-v figure">3</span><span class="cf-k figure-label">Markets traded</span></li>
        <li><span class="cf-v figure">24/7</span><span class="cf-k figure-label">Execution</span></li>
        <li><span class="cf-v figure">7 days</span><span class="cf-k figure-label">Free trial</span></li>
      </ul>
    </div>
  </section>

  <TrialCta />
</Layout>

<style>
  .page-hero { padding-block: clamp(2.5rem, 6vw, 4rem) clamp(1rem, 3vw, 2rem); }
  .page-hero h1 { font-size: clamp(2.4rem, 6vw, 4rem); margin-top: 1.2rem; }
  .lede { color: var(--ink-3); font-size: 1.08rem; max-width: 54ch; margin-top: 1.2rem; }

  .overall-sec { padding-top: clamp(1rem, 3vw, 2rem); }
  .overall-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .ov { padding: 1.5rem; }
  .ov-v { display: block; font-size: clamp(1.7rem, 3.5vw, 2.3rem); color: var(--green-deep); }
  .ov-k { display: block; margin-top: 0.4rem; }

  .bot-rows { display: grid; gap: 1rem; }
  .row {
    display: grid; grid-template-columns: 0.8fr 1.6fr 0.8fr auto;
    gap: clamp(1.25rem, 3vw, 2.25rem); align-items: center;
  }
  .r-id h3 { font-size: 1.4rem; }
  .r-market { font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-4); }
  .r-arch { color: var(--ink-3); font-size: 0.93rem; max-width: 44ch; }
  .rv { display: block; font-size: 1.7rem; color: var(--green-deep); }
  .rk { display: block; margin-top: 0.2rem; }
  .r-link { white-space: nowrap; }

  .clients { display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(1.5rem, 5vw, 3.5rem); align-items: center; padding: clamp(2rem, 5vw, 3.25rem); }
  .c-copy h2 { font-size: clamp(2rem, 4.5vw, 3rem); margin-top: 1rem; }
  .c-copy .big { color: var(--green-deep); font-variant-numeric: tabular-nums; }
  .c-copy p { color: var(--ink-3); margin: 1rem 0 1.6rem; max-width: 48ch; }
  .c-facts { display: grid; gap: 1rem; }
  .c-facts li { padding: 1rem 1.25rem; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--paper); display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .cf-v { font-size: 1.3rem; }

  @media (max-width: 980px) {
    .row { grid-template-columns: 1fr 1fr; }
    .r-arch { grid-column: 1 / -1; }
    .r-link { justify-self: start; }
  }
  @media (max-width: 760px) {
    .overall-grid { grid-template-columns: 1fr 1fr; }
    .clients { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .row { grid-template-columns: 1fr; }
    .overall-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
