---
import Layout from '../layouts/Layout.astro';
import TrialCta from '../components/TrialCta.astro';

// Confirmed figures — static, reviewed quarterly with the product team.
const overall = [
  { v: '25–32%', k: 'Yearly ROI' },
  { v: '4–5%', k: 'Avg. monthly ROI' },
  { v: '92%', k: 'Win rate, all bots', count: 92, suffix: '%' },
  { v: '1–2%', k: 'Drawdown, all bots' },
  { v: '548', k: 'Days live + backtested', count: 548 },
  { v: '4,000+', k: 'Clients', count: 4000, suffix: '+' },
];

// ~4,000 users split across the three bots.
const bots = [
  {
    name: 'Mira', market: 'Gold · XAU/USD',
    arch: 'Trend-following on gold with strict per-trade risk caps.',
    roi: '3–5%',
    clients: '1,350+',
    drawdown: '1–2%',
  },
  {
    name: 'Axon', market: 'Bitcoin · BTC/USD',
    arch: 'Momentum and liquidity analysis on the Bitcoin market.',
    roi: '5–7%',
    clients: '1,600+',
    drawdown: '1–2%',
  },
  {
    name: 'Kairo', market: 'Forex · USD/JPY',
    arch: 'Mean-reversion scalping within the USD/JPY corridor.',
    roi: '4–6%',
    clients: '1,050+',
    drawdown: '1–2%',
  },
];
---

<Layout title="Vectora — Results" description="Vectora performance: 25–32% yearly ROI, 4–5% average monthly ROI, 92% win rate and 1–2% drawdown across 548 days of live trading and backtesting.">
  <section class="section page-hero">
    <div class="container">
      <h1 class="reveal">The numbers,<br /><span class="grad-text">plainly stated.</span></h1>
      <p class="lede reveal" style="--reveal-delay:120ms">
        Every figure on this page comes from live trading plus 1.5 years of
        backtesting. They are static, reviewed quarterly — not live tickers,
        not projections.
      </p>
    </div>
  </section>

  <section class="section overall-sec">
    <div class="container">
      <ul class="overall-grid reveal">
        {overall.map((m) => (
          <li class="ov card spot">
            {m.count
              ? <span class="ov-v figure" data-count={m.count} data-suffix={m.suffix ?? ''}>{m.v}</span>
              : <span class="ov-v figure">{m.v}</span>}
            <span class="ov-k figure-label">{m.k}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section perbot-sec">
    <div class="container">
      <div class="section-head reveal">
        <h2>Performance, <span class="grad-text">per bot</span></h2>
      </div>

      <div class="bot-rows">
        {bots.map((b, i) => (
          <article class="row card spot reveal" style={`--reveal-delay:${i * 80}ms`}>
            <div class="r-id">
              <h3>{b.name}</h3>
              <span class="r-market">{b.market}</span>
              <p class="r-arch">{b.arch}</p>
            </div>

            <dl class="r-metrics">
              <div class="m">
                <dt class="figure-label">Target ROI</dt>
                <dd class="figure accent">{b.roi}</dd>
                <span class="m-sub">Monthly</span>
              </div>
              <div class="m">
                <dt class="figure-label">Clients</dt>
                <dd class="figure">{b.clients}</dd>
                <span class="m-sub">Using this bot</span>
              </div>
              <div class="m">
                <dt class="figure-label">Drawdown</dt>
                <dd class="figure">{b.drawdown}</dd>
                <span class="m-sub">Max, verified</span>
              </div>
            </dl>

            <a href="/bots" class="btn btn-outline r-link">View full strategy <span class="arrow" aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>

      <p class="note reveal" style="margin-top: 1.25rem;">
        Win rate (92%) is measured across all three bots combined. Detailed
        per-bot strategy breakdowns are being prepared and will be published here.
        Trading involves risk of loss; past performance does not guarantee future results.
      </p>
    </div>
  </section>

  <section class="section clients-sec">
    <div class="container clients card grad-border spot reveal">
      <div class="c-copy">
        <h2><span class="big" data-count="4000" data-suffix="+">4,000+</span> clients</h2>
        <p>
          From first-time algo users to experienced traders, more than 4,000
          clients run Vectora bots on their accounts today — with full
          visibility of every trade.
        </p>
        <a href="/support" class="btn btn-primary btn-lg">Get a call from our team <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <ul class="c-facts">
        <li><span class="cf-v figure">3</span><span class="cf-k figure-label">Markets traded</span></li>
        <li><span class="cf-v figure">24/7</span><span class="cf-k figure-label">Execution</span></li>
        <li><span class="cf-v figure">7 days</span><span class="cf-k figure-label">Free trial</span></li>
      </ul>
    </div>
  </section>

  <TrialCta />
</Layout>

<style>
  .page-hero { padding-block: clamp(2.5rem, 6vw, 4rem) clamp(1rem, 3vw, 2rem); }
  .page-hero h1 { font-size: clamp(2.4rem, 6vw, 4rem); }
  .lede { color: var(--text-3); font-size: 1.08rem; max-width: 54ch; margin-top: 1.3rem; }

  .overall-sec { padding-top: clamp(1rem, 3vw, 2rem); }
  .overall-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .ov { padding: 1.5rem; }
  .ov-v { display: block; font-size: clamp(1.7rem, 3.5vw, 2.3rem); color: var(--green-bright); }
  .ov-k { display: block; margin-top: 0.4rem; }

  .bot-rows { display: grid; gap: 1rem; }
  .row {
    display: grid; grid-template-columns: 1.1fr 1.5fr auto;
    gap: clamp(1.25rem, 3vw, 2.5rem); align-items: center;
  }
  .r-id h3 { font-size: 1.4rem; }
  .r-market { font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-4); }
  .r-arch { color: var(--text-3); font-size: 0.9rem; margin-top: 0.6rem; max-width: 40ch; }

  .r-metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .m { display: flex; flex-direction: column; gap: 0.3rem; }
  .m dd { font-size: 1.45rem; margin: 0; }
  .m dd.accent { color: var(--green-bright); }
  .m-sub { font-size: 0.72rem; color: var(--text-4); }

  .r-link { white-space: nowrap; justify-self: end; }

  .clients {
    display: grid; grid-template-columns: 1.5fr 1fr;
    gap: clamp(1.5rem, 5vw, 3.5rem); align-items: center;
    padding: clamp(2rem, 5vw, 3.25rem);
    border-radius: var(--radius-lg);
    box-shadow: 0 0 70px -28px var(--green-glow);
  }
  .c-copy h2 { font-size: clamp(2rem, 4.5vw, 3rem); }
  .c-copy .big {
    background: var(--grad-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-variant-numeric: tabular-nums;
  }
  .c-copy p { color: var(--text-3); margin: 1rem 0 1.6rem; max-width: 48ch; }
  .c-facts { display: grid; gap: 1rem; }
  .c-facts li {
    padding: 1rem 1.25rem;
    border: 1px solid var(--line); border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.025);
    display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
  }
  .cf-v { font-size: 1.3rem; color: var(--green-bright); }

  @media (max-width: 980px) {
    .row { grid-template-columns: 1fr; }
    .r-link { justify-self: start; }
  }
  @media (max-width: 760px) {
    .overall-grid { grid-template-columns: 1fr 1fr; }
    .clients { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .r-metrics { grid-template-columns: 1fr 1fr; }
  }
</style>
