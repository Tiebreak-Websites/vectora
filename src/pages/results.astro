---
import Layout from '../layouts/Layout.astro';
import TrialCta from '../components/TrialCta.astro';

// Confirmed figures — static, reviewed quarterly with the product team.
const headline = [
  { v: '25–32%', k: 'Yearly ROI', sub: 'Across all bots' },
  { v: '4–5%', k: 'Avg. monthly ROI', sub: 'Across all bots' },
  { v: '92%', k: 'Win rate', sub: 'All bots combined', count: 92, suffix: '%' },
];

const secondary = [
  { v: '1–2%', k: 'Max drawdown' },
  { v: '548', k: 'Days live + backtested', count: 548 },
  { v: '4,000+', k: 'Clients', count: 4000, suffix: '+' },
];

// ~4,000 users split across the three bots.
const bots = [
  {
    name: 'Mira', market: 'Gold', pair: 'XAU/USD',
    arch: 'Trend-following on gold with strict per-trade risk caps.',
    roi: '3–5%',
    clients: '1,350+',
    drawdown: '1–2%',
    spark: 'M2 30 L16 26 L30 28 L44 22 L58 24 L72 18 L86 20 L100 14 L114 16 L128 10',
  },
  {
    name: 'Axon', market: 'Bitcoin', pair: 'BTC/USD',
    arch: 'Momentum and liquidity analysis on the Bitcoin market.',
    roi: '5–7%',
    clients: '1,600+',
    drawdown: '1–2%',
    spark: 'M2 32 L16 24 L30 27 L44 16 L58 21 L72 12 L86 17 L100 8 L114 12 L128 4',
  },
  {
    name: 'Kairo', market: 'Forex', pair: 'USD/JPY',
    arch: 'Mean-reversion scalping within the USD/JPY corridor.',
    roi: '4–6%',
    clients: '1,050+',
    drawdown: '1–2%',
    spark: 'M2 28 L16 24 L30 26 L44 20 L58 23 L72 17 L86 19 L100 13 L114 15 L128 8',
  },
];
---

<Layout title="Vectora — Results" description="Vectora performance: 25–32% yearly ROI, 4–5% average monthly ROI, 92% win rate and 1–2% drawdown across 548 days of live trading and backtesting.">
  <section class="section page-hero">
    <div class="container">
      <h1 class="reveal">The numbers, <span class="grad-text">plainly stated.</span></h1>
      <p class="lede reveal" style="--reveal-delay:120ms">
        Every figure on this page comes from live trading plus 1.5 years of
        backtesting. They are static, reviewed quarterly — not live tickers,
        not projections.
      </p>
    </div>
  </section>

  <section class="section score-sec">
    <div class="container">
      <ul class="score-grid reveal">
        {headline.map((m) => (
          <li class="score card spot">
            {m.count
              ? <span class="sc-v" data-count={m.count} data-suffix={m.suffix ?? ''}>{m.v}</span>
              : <span class="sc-v">{m.v}</span>}
            <span class="sc-k figure-label">{m.k}</span>
            <span class="sc-sub">{m.sub}</span>
          </li>
        ))}
      </ul>

      <ul class="second-grid reveal" style="--reveal-delay:120ms">
        {secondary.map((m) => (
          <li class="second card spot">
            {m.count
              ? <span class="sd-v figure" data-count={m.count} data-suffix={m.suffix ?? ''}>{m.v}</span>
              : <span class="sd-v figure">{m.v}</span>}
            <span class="sd-k figure-label">{m.k}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section perbot-sec">
    <div class="container">
      <div class="section-head reveal">
        <h2>Performance, <span class="grad-text">per bot</span></h2>
        <p>Target monthly return ranges, real client adoption and the same 1–2% drawdown cap on every engine.</p>
      </div>

      <div class="bot-grid">
        {bots.map((b, i) => (
          <article class="pb card hoverable spot reveal" style={`--reveal-delay:${i * 90}ms`}>
            <div class="pb-top">
              <h3>{b.name}</h3>
              <span class="pb-pair">{b.pair}</span>
            </div>
            <span class="pb-market">{b.market}</span>
            <p class="pb-arch">{b.arch}</p>

            <svg class="spark" viewBox="0 0 130 36" aria-hidden="true" preserveAspectRatio="none">
              <path d={b.spark} fill="none" stroke="url(#resspark)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>

            <dl class="pb-metrics">
              <div><dt>Target ROI / month</dt><dd class="accent">{b.roi}</dd></div>
              <div><dt>Clients using this bot</dt><dd>{b.clients}</dd></div>
              <div><dt>Max drawdown</dt><dd>{b.drawdown}</dd></div>
            </dl>

            <a href="/bots" class="btn btn-outline pb-cta">View full strategy <span class="arrow" aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>

      <svg width="0" height="0" aria-hidden="true">
        <defs>
          <linearGradient id="resspark" x1="0" y1="1" x2="1" y2="0">
            <stop offset="0" stop-color="#09A165" />
            <stop offset="1" stop-color="#17D48B" />
          </linearGradient>
        </defs>
      </svg>

      <p class="note pb-note reveal">
        Win rate (92%) is measured across all three bots combined. Detailed
        per-bot strategy breakdowns are being prepared and will be published here.
        Trading involves risk of loss; past performance does not guarantee future results.
      </p>
    </div>
  </section>

  <section class="section clients-sec">
    <div class="container clients grad-border spot reveal">
      <h2><span class="big" data-count="4000" data-suffix="+">4,000+</span> clients</h2>
      <p>
        From first-time algo users to experienced traders, more than 4,000
        clients run Vectora bots on their accounts today — with full
        visibility of every trade.
      </p>
      <ul class="c-facts">
        <li><span class="cf-v figure">3</span><span class="cf-k figure-label">Markets traded</span></li>
        <li><span class="cf-v figure">24/7</span><span class="cf-k figure-label">Execution</span></li>
        <li><span class="cf-v figure">7 days</span><span class="cf-k figure-label">Free trial</span></li>
      </ul>
      <a href="/support" class="btn btn-primary btn-lg">Get a call from our team <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>

  <TrialCta />
</Layout>

<style>
  .score-sec { padding-top: clamp(1rem, 3vw, 2rem); }
  .score-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.1rem; }
  .score {
    padding: clamp(1.75rem, 3.5vw, 2.5rem);
    text-align: center;
    overflow: hidden;
  }
  .score::after {
    content: '';
    position: absolute;
    left: 20%; right: 20%; bottom: 0;
    height: 2px;
    background: var(--grad-green);
    opacity: 0.65;
  }
  .sc-v {
    display: block;
    font-family: var(--font-display); font-weight: 600; letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    background: var(--grad-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .sc-k { display: block; margin-top: 0.6rem; }
  .sc-sub { display: block; margin-top: 0.3rem; font-size: 0.82rem; color: var(--text-4); }

  .second-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.1rem; margin-top: 1.1rem; }
  .second { padding: 1.4rem; text-align: center; }
  .sd-v { display: block; font-size: clamp(1.5rem, 3vw, 2rem); color: var(--green-bright); }
  .sd-k { display: block; margin-top: 0.35rem; }

  .bot-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .pb { display: flex; flex-direction: column; }
  .pb-top { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .pb-top h3 { font-size: 1.55rem; }
  .pb-pair { font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-4); letter-spacing: 0.06em; }
  .pb-market {
    display: inline-block; margin-top: 0.5rem; align-self: flex-start;
    font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--green-bright); background: var(--green-tint);
    border: 1px solid rgba(23, 212, 139, 0.25);
    padding: 0.3rem 0.6rem; border-radius: 4px;
  }
  .pb-arch { color: var(--text-3); font-size: 0.93rem; margin-top: 1rem; }
  .spark { width: 100%; height: 38px; margin-top: 1.1rem; opacity: 0.9; }

  .pb-metrics { display: grid; margin-top: 0.9rem; border-top: 1px solid var(--line); flex: 1; align-content: start; }
  .pb-metrics > div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.65rem 0; border-bottom: 1px solid var(--line); }
  .pb-metrics dt { color: var(--text-3); font-size: 0.85rem; }
  .pb-metrics dd { font-family: var(--font-display); font-weight: 600; font-size: 0.95rem; color: var(--text); }
  .pb-metrics dd.accent { color: var(--green-bright); }

  .pb-cta { width: 100%; margin-top: 1.25rem; }
  .pb-note { margin-top: 1.5rem; text-align: center; max-width: 72ch; margin-inline: auto; }

  .clients {
    display: flex; flex-direction: column; align-items: center; text-align: center;
    padding: clamp(2.5rem, 6vw, 4rem) clamp(1.5rem, 5vw, 3.25rem);
    border-radius: var(--radius-lg);
    position: relative;
    box-shadow: 0 0 70px -28px var(--green-glow);
  }
  .clients h2 { font-size: clamp(2.1rem, 4.8vw, 3.2rem); }
  .clients .big {
    background: var(--grad-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-variant-numeric: tabular-nums;
  }
  .clients > p { color: var(--text-3); margin-top: 1rem; max-width: 52ch; }
  .c-facts {
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: 1rem;
    margin-top: 1.75rem;
  }
  .c-facts li {
    padding: 0.85rem 1.4rem;
    border: 1px solid var(--line); border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.025);
    display: flex; align-items: baseline; gap: 0.8rem;
  }
  .cf-v { font-size: 1.2rem; color: var(--green-bright); }
  .clients .btn { margin-top: 2rem; }

  @media (max-width: 900px) {
    .score-grid, .second-grid { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; }
    .second-grid { margin-top: 1.1rem; }
    .bot-grid { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; }
  }
</style>
