---
import Layout from '../layouts/Layout.astro';
import ClosingCta from '../components/ClosingCta.astro';

// Official copy — packages page.
const tiers = [
  {
    name: 'Foundation Package',
    bot: 'MIRA',
    sub: 'Gold Bot',
    price: '$3,000',
    featured: false,
    rows: [
      { k: 'Monthly Average ROI', v: '3–5%', accent: true },
      { k: 'Instrument', v: 'Gold (XAU)' },
      { k: 'Bot capacity', v: '01 unit' },
      { k: 'Trial', v: '7-day trial' },
    ],
    includes: 'Guardian risk check, basic setup support, live/backtested bot logic, private client onboarding.',
  },
  {
    name: 'Advance Package',
    bot: 'AXON',
    sub: 'BTC Bot',
    price: '$4,000',
    featured: true,
    rows: [
      { k: 'Monthly Average ROI', v: '5–7%', accent: true },
      { k: 'Instrument', v: 'Bitcoin (BTC)' },
      { k: 'Bot capacity', v: '01 unit' },
      { k: 'Trial', v: '7-day trial' },
    ],
    includes: 'Expanded risk context, BTC movement monitoring, priority setup support, private client onboarding.',
  },
  {
    name: 'Elite Pro',
    bot: 'KAIRO',
    sub: 'USD/JPY Bot',
    price: '$5,000',
    featured: false,
    rows: [
      { k: 'Monthly Average ROI', v: '4–6%', accent: true },
      { k: 'Instrument', v: 'USD/JPY' },
      { k: 'Bot capacity', v: '01 unit' },
      { k: 'Trial', v: '7-day trial' },
    ],
    includes: 'Pro-level guardian logic, USD/JPY timing support, advanced setup support, private client onboarding.',
  },
];

const compare = [
  { feature: 'Instrument', foundation: 'Gold (XAU)', advance: 'Bitcoin (BTC)', elite: 'USD/JPY' },
  { feature: 'Monthly Average ROI', foundation: '3–5%', advance: '5–7%', elite: '4–6%' },
  { feature: 'Package Price', foundation: '$3,000', advance: '$4,000', elite: '$5,000' },
  { feature: 'Trial', foundation: '7 days', advance: '7 days', elite: '7 days' },
  { feature: 'Risk Check', foundation: 'Core guardian check', advance: 'Expanded guardian check', elite: 'Pro guardian check' },
  { feature: 'Client Support', foundation: 'Setup support', advance: 'Priority setup support', elite: 'Pro setup support' },
  { feature: 'Availability', foundation: 'Coming soon', advance: 'Coming soon', elite: 'Coming soon' },
];
---

<Layout title="Vectora — Packages" description="Choose your Guardian Bot package. Select one bot package based on your preferred instrument and monthly ROI profile. Packages are coming soon and will be activated through our supported broker setup.">
  <section class="section page-hero">
    <div class="container">
      <p class="eyebrow reveal">Bot package types</p>
      <h1 class="reveal" style="--reveal-delay:80ms">Choose your <span class="grad-text">Guardian Bot package.</span></h1>
      <p class="lede reveal" style="--reveal-delay:140ms">
        Select one bot package based on your preferred instrument and monthly
        ROI profile. Packages are coming soon and will be activated through
        our supported broker setup.
      </p>
    </div>
  </section>

  <section class="section tiers-sec">
    <div class="container">
      <div class="tier-grid">
        {tiers.map((t, i) => (
          <article class={`tier card spot reveal ${t.featured ? 'featured grad-border' : ''}`} style={`--reveal-delay:${i * 90}ms`}>
            <div class="tier-head">
              <h3>{t.name}</h3>
              <span class="tier-bot">{t.bot}</span>
            </div>
            <span class="tier-sub">{t.sub}</span>
            <div class="price">
              <span class="amt figure">{t.price}</span>
              <span class="per">/ setup</span>
            </div>

            <dl class="t-rows">
              {t.rows.map((r) => (
                <div><dt>{r.k}</dt><dd class={r.accent ? 'accent' : ''}>{r.v}</dd></div>
              ))}
            </dl>

            <div class="includes">
              <span class="inc-label">Includes</span>
              <p>{t.includes}</p>
            </div>

            <span class="btn btn-outline t-cta soon" aria-disabled="true">Coming soon</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section compare-sec">
    <div class="container">
      <div class="section-head reveal">
        <h2>Detailed <span class="grad-text">comparative logic</span></h2>
      </div>

      <div class="table-wrap card reveal">
        <table class="compare">
          <thead>
            <tr><th>Feature Set</th><th>Foundation · MIRA</th><th>Advance · AXON</th><th>Elite Pro · KAIRO</th></tr>
          </thead>
          <tbody>
            {compare.map((row) => (
              <tr>
                <td class="feat">{row.feature}</td>
                <td>{row.foundation}</td>
                <td class="hl">{row.advance}</td>
                <td>{row.elite}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <ClosingCta
    title='Ready to add a <span class="grad-text">guardian layer?</span>'
    body="Our team can help you choose Mira, Axon, or Kairo based on your instrument preference and trading goals. You will join through one of our supported brokers."
    primary={{ label: 'Schedule consultation', href: '/support' }}
    secondary={{ label: 'View bot packages', href: '/bots' }}
  />
</Layout>

<style>
  .tiers-sec { padding-top: clamp(1rem, 3vw, 2rem); }
  .tier-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; align-items: stretch; }
  .tier { position: relative; display: flex; flex-direction: column; padding: 2rem 1.75rem; }
  .tier.featured { box-shadow: 0 0 60px -22px var(--green-glow); }
  .tier-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .tier h3 { font-size: 1.3rem; }
  .tier-bot {
    flex: none;
    font-family: var(--font-mono); font-size: 0.68rem; font-weight: 500;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--green-bright); background: var(--green-tint);
    border: 1px solid rgba(23, 212, 139, 0.25);
    padding: 0.3rem 0.55rem; border-radius: 4px;
  }
  .tier-sub { font-family: var(--font-mono); font-size: 0.76rem; color: var(--text-3); margin-top: 0.35rem; }
  .price { display: flex; align-items: baseline; gap: 0.45rem; margin: 1.1rem 0 1.3rem; }
  .amt { font-size: 2.6rem; line-height: 1; color: var(--green-bright); }
  .per { font-family: var(--font-mono); color: var(--text-4); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .t-rows { display: grid; border-top: 1px solid var(--line); }
  .t-rows > div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.65rem 0; border-bottom: 1px solid var(--line); }
  .t-rows dt { color: var(--text-3); font-size: 0.85rem; }
  .t-rows dd { font-family: var(--font-display); font-weight: 600; font-size: 0.9rem; color: var(--text); text-align: right; }
  .t-rows dd.accent { color: var(--green-bright); }
  .includes { margin: 1.1rem 0 1.4rem; padding: 1rem; border: 1px solid var(--line); border-radius: var(--radius-sm); background: rgba(255, 255, 255, 0.02); }
  .inc-label { font-family: var(--font-mono); font-size: 0.66rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--green-bright); }
  .includes p { color: var(--text-3); font-size: 0.87rem; margin-top: 0.4rem; }
  .t-cta { width: 100%; margin-top: auto; }
  .t-cta.soon {
    cursor: default;
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--text-3);
  }
  .t-cta.soon:hover { transform: none; border-color: var(--line-strong); box-shadow: none; }

  .table-wrap { overflow-x: auto; padding: 0; }
  table.compare { width: 100%; border-collapse: collapse; min-width: 680px; }
  .compare th, .compare td { text-align: left; padding: 0.95rem 1.25rem; border-bottom: 1px solid var(--line); }
  .compare thead th {
    font-family: var(--font-mono); font-weight: 500; font-size: 0.72rem;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-4);
    background: rgba(0, 0, 0, 0.25);
  }
  .compare tbody tr { transition: background 0.2s ease; }
  .compare tbody tr:hover { background: rgba(255, 255, 255, 0.025); }
  .compare tbody tr:last-child td { border-bottom: 0; }
  .compare td { font-size: 0.94rem; color: var(--text-2); }
  .compare td.feat { font-family: var(--font-display); font-weight: 600; color: var(--text); }
  .compare td.hl { color: var(--green-bright); font-weight: 500; }

  @media (max-width: 900px) {
    .tier-grid { grid-template-columns: 1fr; max-width: 420px; margin-inline: auto; }
  }
</style>
