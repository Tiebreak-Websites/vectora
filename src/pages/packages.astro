---
import Layout from '../layouts/Layout.astro';

const tiers = [
  {
    tier: 'Tier 01',
    name: 'Foundation Package',
    price: '$3,000',
    period: '/ setup',
    featured: false,
    rows: [
      { k: 'Bot capacity', v: '01 unit' },
      { k: 'Min. deposit', v: '$5,000.00' },
    ],
    maintenance: '3 months free maintenance included. Reg. $100/mo thereafter.',
    perks: ['Monthly account check-ins'],
    cta: 'Select package',
  },
  {
    tier: 'Tier 02',
    name: 'Advance Package',
    price: '$5,000',
    period: '/ setup',
    featured: true,
    rows: [
      { k: 'Min. deposit', v: '$10,000.00' },
      { k: 'Execution', v: 'Advanced settings' },
    ],
    maintenance: 'Reg. $100/mo thereafter.',
    perks: ['Weekly priority check-ins'],
    cta: 'Upgrade now',
  },
  {
    tier: 'Tier 03',
    name: 'Professional Elite',
    price: '$7,000',
    period: '/ setup',
    featured: false,
    rows: [
      { k: 'Min. deposit', v: '$25,000.00' },
      { k: 'Maintenance', v: '$200 annual fixed' },
    ],
    maintenance: '$200 annual fixed fee only.',
    perks: ['Weekly strategic check-ins', 'Real-time macro event alerts'],
    cta: 'Request elite access',
  },
];

const compare = [
  { feature: 'Algorithmic Precision', foundation: 'Standard', advance: 'High-Frequency', elite: 'Quantum Priority' },
  { feature: 'Risk Management Matrix', foundation: 'Auto-Stop', advance: 'Dynamic Hedging', elite: 'Institutional Grade' },
  { feature: 'Account Manager Access', foundation: 'Email / Portal', advance: 'Dedicated Slack', elite: 'Direct Line / 24-7' },
  { feature: 'System Latency', foundation: '5ms', advance: '1.2ms', elite: '<0.5ms' },
];
---

<Layout title="Vectora — Our Packages" description="Institutional deployment tiers for Vectora's high-frequency execution protocols. Foundation, Advance and Professional Elite packages.">
  <section class="section page-hero">
    <div class="container">
      <span class="eyebrow reveal"><span class="dot"></span> System classification: institutional tiers</span>
      <h1 class="reveal" style="--reveal-delay:80ms">High-Frequency <span class="text-accent">Execution Protocols</span>.</h1>
      <p class="lede reveal" style="--reveal-delay:140ms">
        Select a deployment package optimised for your capital allocation. All bots
        operate on our proprietary quantum-kinetic latency engine.
      </p>
    </div>
  </section>

  <section class="section tiers-sec">
    <div class="container">
      <div class="tier-grid">
        {tiers.map((t, i) => (
          <article class={`tier reveal ${t.featured ? 'featured' : ''}`} style={`--reveal-delay:${i * 90}ms`}>
            {t.featured && <span class="rec">Recommended</span>}
            <span class="tier-no">{t.tier}</span>
            <h3>{t.name}</h3>
            <div class="price"><span class="amt">{t.price}</span><span class="per">{t.period}</span></div>

            <dl class="t-rows">
              {t.rows.map((r) => (
                <div><dt>{r.k}</dt><dd>{r.v}</dd></div>
              ))}
            </dl>

            <div class="maint"><span class="maint-label">Maintenance</span><p>{t.maintenance}</p></div>

            <ul class="perks">
              {t.perks.map((p) => (
                <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>{p}</li>
              ))}
            </ul>

            <a href="/support" class={`btn ${t.featured ? 'btn-primary' : 'btn-ghost'} t-cta`}>{t.cta}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section compare-sec">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Technical specification breakdown</span>
        <h2>Detailed <span class="text-accent">comparative logic</span></h2>
      </div>

      <div class="table-wrap reveal">
        <table class="compare">
          <thead>
            <tr><th>Feature set</th><th>Foundation</th><th>Advance</th><th>Elite</th></tr>
          </thead>
          <tbody>
            {compare.map((row) => (
              <tr>
                <td class="feat">{row.feature}</td>
                <td>{row.foundation}</td>
                <td>{row.advance}</td>
                <td class="elite">{row.elite}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section cta-sec">
    <div class="container cta reveal">
      <h2>Ready to <span class="text-accent">initiate deployment</span>?</h2>
      <p>Our institutional consultants are available to assist with your initial bot configuration and capital structuring.</p>
      <div class="cta-actions">
        <a href="/support" class="btn btn-primary btn-lg">Schedule consultation</a>
        <a href="/bots" class="btn btn-ghost btn-lg">View system docs</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero { padding-block: clamp(2.5rem, 6vw, 4rem) clamp(1rem, 3vw, 2rem); }
  .page-hero h1 { font-size: clamp(2.4rem, 6vw, 4rem); font-weight: 800; margin-top: 1.2rem; max-width: 16ch; }
  .lede { color: var(--c-text-muted); font-size: 1.1rem; max-width: 56ch; margin-top: 1.2rem; }

  .tiers-sec { padding-top: clamp(1rem, 3vw, 2rem); }
  .tier-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; align-items: start; }
  .tier {
    position: relative; display: flex; flex-direction: column;
    padding: 2rem 1.75rem; background: var(--grad-panel);
    border: 1px solid var(--glass-border); border-radius: var(--radius-lg);
    backdrop-filter: blur(var(--glass-blur));
  }
  .tier.featured { border-color: rgba(18,201,125,0.45); box-shadow: var(--glow-accent); transform: translateY(-8px); }
  .rec {
    position: absolute; top: 0; right: 0;
    font-family: var(--font-display); font-size: 0.66rem; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase; color: #062A1B;
    background: var(--grad-accent); padding: 0.35rem 0.7rem;
    border-radius: 0 var(--radius-lg) 0 var(--radius);
  }
  .tier-no { font-family: var(--font-display); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--c-text-dim); }
  .tier h3 { font-size: 1.5rem; margin-top: 0.3rem; }
  .price { display: flex; align-items: baseline; gap: 0.4rem; margin: 1rem 0 1.4rem; }
  .amt { font-family: var(--font-display); font-weight: 800; font-size: 2.6rem; letter-spacing: -0.03em; color: var(--c-accent-bright); }
  .per { color: var(--c-text-dim); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .t-rows { display: grid; gap: 0; border-top: 1px solid var(--c-border); }
  .t-rows > div { display: flex; justify-content: space-between; padding: 0.7rem 0; border-bottom: 1px solid var(--c-border); }
  .t-rows dt { color: var(--c-text-muted); font-size: 0.85rem; }
  .t-rows dd { font-family: var(--font-display); font-weight: 600; font-size: 0.9rem; color: var(--c-text); }
  .maint { margin: 1.1rem 0; padding: 1rem; border: 1px solid var(--glass-border); border-radius: var(--radius); background: var(--c-accent-soft); }
  .maint-label { font-family: var(--font-display); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-accent-bright); }
  .maint p { color: var(--c-text-muted); font-size: 0.85rem; margin-top: 0.4rem; }
  .perks { display: grid; gap: 0.6rem; margin-bottom: 1.4rem; }
  .perks li { display: flex; gap: 0.55rem; align-items: flex-start; color: var(--c-text-soft); font-size: 0.92rem; }
  .perks svg { width: 17px; height: 17px; color: var(--c-accent-bright); flex: none; margin-top: 2px; }
  .t-cta { width: 100%; margin-top: auto; }

  .table-wrap { overflow-x: auto; border: 1px solid var(--glass-border); border-radius: var(--radius-lg); background: var(--grad-panel); }
  table.compare { width: 100%; border-collapse: collapse; min-width: 640px; }
  .compare th, .compare td { text-align: left; padding: 1rem 1.25rem; border-bottom: 1px solid var(--c-border); }
  .compare thead th { font-family: var(--font-display); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-text-dim); background: rgba(0,0,0,0.2); }
  .compare tbody tr:last-child td { border-bottom: 0; }
  .compare td { font-size: 0.94rem; color: var(--c-text-soft); }
  .compare td.feat { font-family: var(--font-display); font-weight: 600; color: var(--c-text); }
  .compare td.elite { color: var(--c-accent-bright); font-weight: 600; }

  .cta { text-align: center; max-width: 680px; margin-inline: auto; padding: clamp(2rem, 5vw, 3.5rem); background: var(--grad-soft); border: 1px solid var(--glass-border); border-radius: var(--radius-lg); }
  .cta h2 { font-size: clamp(1.8rem, 4vw, 2.7rem); }
  .cta p { color: var(--c-text-muted); margin-top: 0.8rem; }
  .cta-actions { display: flex; gap: 0.85rem; justify-content: center; flex-wrap: wrap; margin-top: 1.8rem; }

  @media (max-width: 900px) {
    .tier-grid { grid-template-columns: 1fr; max-width: 420px; margin-inline: auto; }
    .tier.featured { transform: none; }
  }
</style>
