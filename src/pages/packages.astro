---
import Layout from '../layouts/Layout.astro';
import ClosingCta from '../components/ClosingCta.astro';

// Official copy — packages page.
// Packages are no longer tied to a single bot: each tier unlocks a number
// of bots (1 / 2 / all 3) and the client picks which ones.
const bots = [
  { name: 'MIRA', market: 'Gold', instrument: 'Gold (XAU)', min: 3, max: 5 },
  { name: 'AXON', market: 'BTC', instrument: 'Bitcoin (BTC)', min: 5, max: 7 },
  { name: 'KAIRO', market: 'Nasdaq', instrument: 'Nasdaq (NDX)', min: 4, max: 6 },
];

const tiers = [
  {
    name: 'Foundation',
    chip: '1 algo',
    sub: 'Any one algo of your choice',
    price: '$3,000',
    margin: '$5,000',
    limit: 1,
    locked: false,
    featured: false,
    available: true,
    defaults: ['MIRA'],
    pickLabel: 'Choose your algo',
    desc: 'Choose any one trading algo based on your preferred market and trading style. Full access to a single algo of your choice.',
    includes: 'Full access to one algo of your choice for 1 year, guardian risk check, technical setup assistance, private client account setup.',
  },
  {
    name: 'Advanced',
    chip: '2 algos',
    sub: 'Any two algos of your choice',
    price: '$5,000',
    margin: '$10,000',
    limit: 2,
    locked: false,
    featured: true,
    defaults: ['MIRA', 'AXON'],
    pickLabel: 'Choose any two algos',
    desc: 'Combine any two trading algos to diversify your trading strategy across multiple markets. Select any two and gain access to both.',
    includes: 'Full access to two algos of your choice for 1 year, expanded risk context, priority technical setup assistance, private client account setup.',
  },
  {
    name: 'Elite',
    chip: '3 algos',
    sub: 'All three algos included',
    price: '$7,000',
    margin: '$15,000',
    limit: 3,
    locked: true,
    featured: false,
    defaults: ['MIRA', 'AXON', 'KAIRO'],
    pickLabel: 'All algos included',
    desc: 'Unlock all three trading algos in one complete package — maximum market exposure, greater diversification, and every available strategy.',
    includes: 'Full access to all three algos for 1 year, pro guardian logic, advanced technical setup assistance, private client account setup.',
  },
];

const selection = (names) => bots.filter((b) => names.includes(b.name));
const roiFor = (names) => {
  const sel = selection(names);
  return `up to ${Math.max(...sel.map((b) => b.max))}%*`;
};
const marketsFor = (names) => selection(names).map((b) => b.market).join(' + ');

const compare = [
  { feature: 'Algos included', foundation: 'Any 1 of 3', advance: 'Any 2 of 3', elite: 'All 3 algos' },
  { feature: 'Algo selection', foundation: 'Your choice', advance: 'Your choice', elite: 'MIRA + AXON + KAIRO' },
  { feature: 'Package Price', foundation: '$3,000', advance: '$5,000', elite: '$7,000' },
  { feature: 'Minimum margin', foundation: '$5,000', advance: '$10,000', elite: '$15,000' },
  { feature: 'Algo access', foundation: '1 year', advance: '1 year', elite: '1 year' },
  { feature: 'Risk Check', foundation: 'Core guardian check', advance: 'Expanded guardian check', elite: 'Pro guardian check' },
  { feature: 'Technical setup', foundation: 'Setup assistance', advance: 'Priority setup assistance', elite: 'Pro setup assistance' },
  { feature: 'Refund', foundation: '60-day refund', advance: '60-day refund', elite: '60-day refund' },
  { feature: 'Availability', foundation: 'Available now', advance: 'Coming soon', elite: 'Coming soon' },
];
---

<Layout title="Vectora — Packages" description="Choose your Guardian Algo package. Foundation unlocks any one algo, Advanced any two, and Elite includes all three. Every package comes with a 60-day refund period.">
  <section class="section page-hero">
    <div class="container">
      <h1 class="reveal">Choose your <span class="grad-text">Guardian Algo package.</span></h1>
      <p class="lede wide reveal" style="--reveal-delay:140ms">
        Pick your package, then choose which algos power it — Foundation
        unlocks any one algo, Advanced any two, and Elite includes all three.
        Foundation is available now; Advanced and Elite are coming soon and
        will be activated through technically compatible broker platforms.
      </p>
    </div>
  </section>

  <section class="section tiers-sec">
    <div class="container">
      <div class="tier-grid">
        {tiers.map((t, i) => (
          <article
            class={`tier card spot reveal ${t.featured ? 'featured grad-border' : ''}`}
            style={`--reveal-delay:${i * 90}ms`}
            data-limit={t.limit}
            data-locked={t.locked ? 'true' : 'false'}
          >
            <div class="tier-head">
              <h3>{t.name}</h3>
              <span class="tier-bot">{t.chip}</span>
            </div>
            <span class="tier-sub">{t.sub}</span>
            <div class="price">
              <span class="amt figure">{t.price}</span>
              <span class="per">/ setup</span>
            </div>
            <p class="tier-desc">{t.desc}</p>

            <div class="picker">
              <div class="pick-head">
                <span class="pick-label">{t.pickLabel}</span>
                <span class="pick-count js-count" aria-live="polite">{t.defaults.length} of {t.limit} selected</span>
              </div>
              <div class="pick-list" role="group" aria-label={`${t.name} algo selection`}>
                {bots.map((b) => (
                  <button
                    type="button"
                    class="pick"
                    aria-pressed={t.defaults.includes(b.name) ? 'true' : 'false'}
                    disabled={t.locked}
                    data-max={b.max}
                    data-market={b.market}
                  >
                    <span class="pick-check" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
                    </span>
                    <span class="pick-copy">
                      <span class="pick-name">{b.name}</span>
                      <span class="pick-market">{b.instrument}</span>
                    </span>
                    <span class="pick-roi">up to {b.max}%*</span>
                  </button>
                ))}
              </div>
            </div>

            <dl class="t-rows">
              <div><dt>Approx. monthly ROI</dt><dd class="accent js-roi">{roiFor(t.defaults)}</dd></div>
              <div><dt>Markets</dt><dd class="js-markets">{marketsFor(t.defaults)}</dd></div>
              <div><dt>Minimum margin</dt><dd>{t.margin}</dd></div>
              <div><dt>Algo access</dt><dd>1 year</dd></div>
              <div><dt>Refund</dt><dd>60-day refund</dd></div>
            </dl>

            <div class="includes">
              <span class="inc-label">Includes</span>
              <p>{t.includes}</p>
            </div>

            {t.available
              ? <a href="/signup" class="btn btn-primary t-cta" aria-label={`Buy the ${t.name} package for ${t.price}`}>{t.price}</a>
              : <span class="btn btn-outline t-cta soon" aria-disabled="true">Coming soon</span>}
          </article>
        ))}
      </div>

      <aside class="refund card reveal" style="--reveal-delay:120ms">
        <span class="refund-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v4h4"/><path d="M9.5 12.2l1.8 1.8 3.7-3.7"/></svg>
        </span>
        <div class="refund-copy">
          <strong>60-day refund period</strong>
          <p>Every package comes with a 60-day refund period and 1 year of algo access from the date of purchase. If the algo has been used, the refund may be reduced proportionally to usage — all refunds are handled under our Terms of Service.</p>
        </div>
        <span class="refund-chip">60 days</span>
      </aside>
    </div>
  </section>

  <section class="section compare-sec">
    <div class="container">
      <div class="section-head reveal">
        <h2>Detailed comparative logic</h2>
      </div>

      <div class="table-wrap card reveal">
        <table class="compare">
          <thead>
            <tr><th>Feature Set</th><th>Foundation</th><th>Advanced</th><th>Elite</th></tr>
          </thead>
          <tbody>
            {compare.map((row) => (
              <tr>
                <td class="feat">{row.feature}</td>
                <td>{row.foundation}</td>
                <td class="hl">{row.advance}</td>
                <td>{row.elite}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <ClosingCta
    title='Ready to add a guardian layer?'
    body="Pick your package and combination of Mira, Axon, and Kairo, and our team will assist with the technical setup. You will connect through a technically compatible broker platform."
    primary={{ label: 'Talk to our team', href: '/support' }}
    secondary={{ label: 'View algo packages', href: '/algos' }}
  />
</Layout>

<script>
  // Bot picker — Foundation swaps its single selection, Advanced keeps a
  // queue of two (picking a third drops the oldest), Elite is locked.
  document.querySelectorAll('.tier[data-locked="false"]').forEach((tier) => {
    const limit = Number(tier.getAttribute('data-limit'));
    const picks = Array.from(tier.querySelectorAll('.pick'));
    const roiEl = tier.querySelector('.js-roi');
    const marketsEl = tier.querySelector('.js-markets');
    const countEl = tier.querySelector('.js-count');
    let selected = picks.filter((p) => p.getAttribute('aria-pressed') === 'true');

    const render = () => {
      picks.forEach((p) => p.setAttribute('aria-pressed', selected.includes(p) ? 'true' : 'false'));
      const maxs = selected.map((p) => Number(p.getAttribute('data-max')));
      if (roiEl) roiEl.textContent = `up to ${Math.max(...maxs)}%*`;
      if (marketsEl) marketsEl.textContent = selected.map((p) => p.getAttribute('data-market')).join(' + ');
      if (countEl) countEl.textContent = `${selected.length} of ${limit} selected`;
    };

    picks.forEach((pick) => {
      pick.addEventListener('click', () => {
        if (selected.includes(pick)) {
          if (selected.length === 1) return; // always keep at least one bot
          selected = selected.filter((p) => p !== pick);
        } else {
          selected = [...selected, pick];
          if (selected.length > limit) selected.shift();
        }
        render();
      });
    });
  });
</script>

<style>
  /* Wide enough that the lede breaks into exactly two sentences / two rows */
  .lede.wide { max-width: 88ch; }

  .tiers-sec { padding-top: clamp(1rem, 3vw, 2rem); }
  .tier-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; align-items: stretch; }
  .tier { position: relative; display: flex; flex-direction: column; padding: 2rem 1.75rem; }
  .tier.featured { box-shadow: 0 0 60px -22px var(--green-glow); }
  .tier-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .tier h3 { font-size: 1.3rem; }
  .tier-bot {
    flex: none;
    font-family: var(--font-mono); font-size: 0.68rem; font-weight: 500;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--text-2); background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--line-strong);
    padding: 0.3rem 0.55rem; border-radius: 4px;
  }
  .tier-sub { font-family: var(--font-mono); font-size: 0.76rem; color: var(--text-3); margin-top: 0.35rem; }
  .price { display: flex; align-items: baseline; gap: 0.45rem; margin: 1.1rem 0 0.9rem; }
  .amt { font-size: 2.6rem; line-height: 1; color: var(--green-bright); }
  .per { font-family: var(--font-mono); color: var(--text-4); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .tier-desc { color: var(--text-3); font-size: 0.88rem; }

  /* ---- Bot picker ---- */
  .picker { margin: 1.2rem 0 1.3rem; }
  .pick-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .pick-label {
    font-family: var(--font-mono); font-size: 0.66rem; font-weight: 500;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-4);
  }
  .pick-count { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.06em; color: var(--text-4); }
  .pick-list { display: grid; gap: 0.5rem; margin-top: 0.65rem; }
  .pick {
    display: flex; align-items: center; gap: 0.7rem;
    width: 100%; text-align: left;
    padding: 0.6rem 0.75rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--line); border-radius: var(--radius-sm);
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .pick:hover { border-color: var(--line-strong); }
  .pick[aria-pressed="true"] { border-color: var(--green-line); background: var(--green-tint); }
  .pick:disabled { cursor: default; }
  .pick-check {
    flex: none;
    display: grid; place-items: center;
    width: 18px; height: 18px;
    border: 1px solid var(--line-strong); border-radius: 50%;
    color: transparent;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .pick[aria-pressed="true"] .pick-check { background: var(--grad-green); border-color: transparent; color: #04281A; }
  .pick-check svg { width: 11px; height: 11px; }
  .pick-copy { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .pick-name { font-family: var(--font-display); font-weight: 600; font-size: 0.88rem; color: var(--text); line-height: 1.2; }
  .pick-market { font-family: var(--font-mono); font-size: 0.68rem; color: var(--text-4); letter-spacing: 0.04em; }
  .pick-roi { margin-left: auto; flex: none; font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-3); }
  .pick[aria-pressed="true"] .pick-roi { color: var(--green-bright); }

  .t-rows { display: grid; border-top: 1px solid var(--line); }
  .t-rows > div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.65rem 0; border-bottom: 1px solid var(--line); }
  .t-rows dt { color: var(--text-3); font-size: 0.85rem; }
  .t-rows dd { font-family: var(--font-display); font-weight: 600; font-size: 0.9rem; color: var(--text); text-align: right; }
  .t-rows dd.accent { color: var(--green-bright); }
  .includes { margin: 1.1rem 0 1.4rem; padding: 1rem; border: 1px solid var(--line); border-radius: var(--radius-sm); background: rgba(255, 255, 255, 0.02); }
  .inc-label { font-family: var(--font-mono); font-size: 0.66rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-4); }
  .includes p { color: var(--text-3); font-size: 0.87rem; margin-top: 0.4rem; }
  .t-cta { width: 100%; margin-top: auto; }
  .t-cta.soon {
    cursor: default;
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--text-3);
  }
  .t-cta.soon:hover { transform: none; border-color: var(--line-strong); box-shadow: none; }

  /* ---- Refund banner ---- */
  .refund {
    margin-top: 1.25rem;
    display: flex; align-items: center; gap: 1.1rem;
    padding: 1.25rem 1.75rem;
  }
  .refund-icon {
    flex: none;
    display: grid; place-items: center;
    width: 44px; height: 44px;
    border-radius: 50%;
    color: var(--green-bright);
    background: var(--green-tint);
    border: 1px solid rgba(23, 212, 139, 0.25);
  }
  .refund-icon svg { width: 22px; height: 22px; }
  .refund-copy strong { display: block; font-family: var(--font-display); font-weight: 600; font-size: 1.02rem; color: var(--text); }
  .refund-copy p { color: var(--text-3); font-size: 0.9rem; margin-top: 0.15rem; }
  .refund-chip {
    margin-left: auto; flex: none;
    font-family: var(--font-mono); font-size: 0.68rem; font-weight: 500;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--green-bright); background: var(--green-tint);
    border: 1px solid rgba(23, 212, 139, 0.25);
    padding: 0.3rem 0.55rem; border-radius: 4px;
  }

  @media (max-width: 640px) {
    .refund { flex-direction: column; text-align: center; gap: 0.8rem; }
    .refund-chip { margin-left: 0; }
  }

  .table-wrap { overflow-x: auto; padding: 0; }
  table.compare { width: 100%; border-collapse: collapse; min-width: 680px; }
  .compare th, .compare td { text-align: left; padding: 0.95rem 1.25rem; border-bottom: 1px solid var(--line); }
  .compare thead th {
    font-family: var(--font-mono); font-weight: 500; font-size: 0.72rem;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-4);
    background: rgba(0, 0, 0, 0.25);
  }
  .compare tbody tr { transition: background 0.2s ease; }
  .compare tbody tr:hover { background: rgba(255, 255, 255, 0.025); }
  .compare tbody tr:last-child td { border-bottom: 0; }
  .compare td { font-size: 0.94rem; color: var(--text-2); }
  .compare td.feat { font-family: var(--font-display); font-weight: 600; color: var(--text); }
  .compare td.hl { color: var(--text); font-weight: 500; }

  @media (max-width: 900px) {
    .tier-grid { grid-template-columns: 1fr; max-width: 420px; margin-inline: auto; }
  }
</style>
