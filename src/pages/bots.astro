---
import Layout from '../layouts/Layout.astro';
import TrialCta from '../components/TrialCta.astro';

const heroStats = [
  { k: 'Markets traded', v: '3' },
  { k: 'Win rate, all bots', v: '92%' },
  { k: 'Drawdown, all bots', v: '1–2%' },
  { k: 'Days live + backtested', v: '548' },
];

const bots = [
  {
    name: 'Mira',
    market: 'Gold',
    pair: 'XAU/USD',
    roi: '3–5%',
    style: 'Trend-following',
    pkg: 'Foundation · $3,000',
    body: 'The defensive engine. Mira follows established trends in the gold market with strict per-trade risk caps — designed for steady, unexciting consistency.',
  },
  {
    name: 'Axon',
    market: 'Bitcoin',
    pair: 'BTC/USD',
    roi: '5–7%',
    style: 'Momentum & liquidity',
    pkg: 'Advanced · $4,000',
    body: 'The highest-yield engine. Axon reads momentum and liquidity shifts in the Bitcoin market and executes without hesitation — around the clock, seven days a week.',
  },
  {
    name: 'Kairo',
    market: 'Forex',
    pair: 'USD/JPY',
    roi: '4–6%',
    style: 'Range scalping',
    pkg: 'Professional · $5,000',
    body: 'The precision scalper. Kairo works the USD/JPY corridor with many small, controlled trades and mean-reversion logic — rather than big directional bets.',
  },
];
---

<Layout title="Vectora — Our Bots" description="Meet Mira, Axon and Kairo — three specialist trading bots for gold, Bitcoin and USD/JPY. 92% win rate and 1–2% drawdown across 548 days of live trading and backtesting.">
  <section class="section page-hero">
    <div class="container">
      <span class="eyebrow reveal">Our bots</span>
      <h1 class="reveal" style="--reveal-delay:80ms">Meet the three.</h1>
      <p class="lede reveal" style="--reveal-delay:140ms">
        Mira, Axon and Kairo each trade one market and nothing else. Every bot
        has run in real time alongside 1.5 years of backtesting — 548 days of
        proof before it touches client capital.
      </p>

      <ul class="hero-stats reveal" style="--reveal-delay:220ms">
        {heroStats.map((s) => (
          <li><span class="num figure">{s.v}</span><span class="k figure-label">{s.k}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bots-sec">
    <div class="container">
      <div class="bot-list">
        {bots.map((b, i) => (
          <article class="bot card reveal" style={`--reveal-delay:${i * 80}ms`}>
            <div class="b-id">
              <div class="b-name-row">
                <h2>{b.name}</h2>
                <span class="pair">{b.pair}</span>
              </div>
              <span class="market">{b.market}</span>
            </div>

            <p class="b-body">{b.body}</p>

            <dl class="b-specs">
              <div><dt>Target monthly ROI</dt><dd class="accent">{b.roi}</dd></div>
              <div><dt>Trading style</dt><dd>{b.style}</dd></div>
              <div><dt>Package</dt><dd>{b.pkg}</dd></div>
            </dl>

            <a href="/packages" class="btn btn-outline b-cta">View package <span class="arrow" aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section testing">
    <div class="container test-grid">
      <div class="test-copy reveal">
        <span class="eyebrow">Tested before trusted</span>
        <h2>548 days of proof</h2>
        <p>
          Each bot runs in real time alongside 1.5 years of backtesting across
          calm and volatile market cycles. Nothing goes live for clients until
          it has held a 92% win rate and kept drawdown within 1–2% — and those
          same rules keep running once it's live.
        </p>
        <p>
          The figures we publish are static and reviewed with the product team.
          What you see on this site is what the bots have actually done — not a
          projection.
        </p>
      </div>

      <div class="test-stats reveal" style="--reveal-delay:120ms">
        <div class="ts-tile"><span class="ts-k figure-label">Win rate</span><span class="ts-v figure">92%</span></div>
        <div class="ts-tile"><span class="ts-k figure-label">Drawdown</span><span class="ts-v figure">1–2%</span></div>
        <div class="ts-tile"><span class="ts-k figure-label">Avg. monthly ROI</span><span class="ts-v figure">4–5%</span></div>
        <div class="ts-tile"><span class="ts-k figure-label">Yearly ROI</span><span class="ts-v figure">25–32%</span></div>
      </div>
    </div>
  </section>

  <TrialCta />
</Layout>

<style>
  .page-hero { padding-block: clamp(2.5rem, 6vw, 4rem) clamp(1rem, 3vw, 2rem); }
  .page-hero h1 { font-size: clamp(2.6rem, 7vw, 4.4rem); margin-top: 1.2rem; }
  .lede { color: var(--ink-3); font-size: 1.1rem; max-width: 58ch; margin-top: 1.2rem; }

  .hero-stats {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;
    margin-top: 2.5rem; padding-top: 1.75rem; border-top: 1px solid var(--line);
  }
  .hero-stats .num { display: block; font-size: clamp(1.5rem, 3vw, 2.1rem); }
  .hero-stats .k { display: block; margin-top: 0.3rem; }

  .bots-sec { padding-top: clamp(1rem, 3vw, 2rem); }
  .bot-list { display: grid; gap: 1.1rem; }
  .bot {
    display: grid; grid-template-columns: 0.8fr 1.4fr 1fr auto;
    gap: clamp(1.25rem, 3vw, 2.5rem); align-items: center;
    padding: clamp(1.5rem, 3vw, 2rem);
  }
  .b-name-row { display: flex; align-items: baseline; gap: 0.7rem; }
  .bot h2 { font-size: 1.8rem; }
  .pair { font-family: var(--font-mono); font-size: 0.78rem; color: var(--ink-4); letter-spacing: 0.06em; }
  .market {
    display: inline-block; margin-top: 0.6rem;
    font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--green-ink); background: var(--green-tint);
    padding: 0.28rem 0.55rem; border-radius: 4px;
  }
  .b-body { color: var(--ink-3); font-size: 0.95rem; max-width: 52ch; }
  .b-specs { display: grid; gap: 0; }
  .b-specs > div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.55rem 0; border-bottom: 1px solid var(--line); }
  .b-specs > div:last-child { border-bottom: 0; }
  .b-specs dt { color: var(--ink-3); font-size: 0.82rem; }
  .b-specs dd { font-family: var(--font-display); font-weight: 600; font-size: 0.88rem; color: var(--ink); text-align: right; white-space: nowrap; }
  .b-specs dd.accent { color: var(--green-deep); }
  .b-cta { white-space: nowrap; }

  .testing { background: var(--paper-2); border-block: 1px solid var(--line); }
  .test-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .test-copy h2 { font-size: clamp(1.9rem, 4vw, 2.6rem); margin-top: 1rem; }
  .test-copy p { color: var(--ink-3); margin-top: 1rem; max-width: 56ch; }

  .test-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .ts-tile { padding: 1.4rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow-card); }
  .ts-k { display: block; }
  .ts-v { display: block; font-size: 1.9rem; margin-top: 0.45rem; color: var(--green-deep); }

  @media (max-width: 980px) {
    .bot { grid-template-columns: 1fr 1fr; }
    .b-body { grid-column: 1 / -1; }
    .b-cta { justify-self: start; }
  }
  @media (max-width: 640px) {
    .bot { grid-template-columns: 1fr; }
    .test-grid { grid-template-columns: 1fr; }
    .hero-stats { grid-template-columns: repeat(2, 1fr); gap: 1.5rem 1rem; }
  }
  @media (max-width: 420px) { .test-stats { grid-template-columns: 1fr; } }
</style>
