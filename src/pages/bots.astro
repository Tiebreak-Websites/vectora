---
import Layout from '../layouts/Layout.astro';
import ClosingCta from '../components/ClosingCta.astro';

// Official copy — bots page.
const badges = ['7-day trial', 'Risk-first design', 'Private client use'];

const heroStats = [
  { v: '25–32%', k: 'Yearly ROI range' },
  { v: '92%', k: 'Overall win rate' },
  { v: '1–2%', k: 'Overall drawdown' },
  { v: '548 days', k: 'Live + backtested operation' },
];

const bots = [
  {
    name: 'MIRA',
    sub: 'Gold Bot',
    rows: [
      { k: 'Status', v: 'Ready', status: true },
      { k: 'Instrument', v: 'Gold (XAU)' },
      { k: 'Monthly Average ROI', v: '3–5%', accent: true },
      { k: 'Price', v: '$3,000' },
      { k: 'Role', v: 'Guardian risk reader' },
    ],
    strategy: 'Gold-focused market monitoring and setup-context checks.',
    guardian: 'Helps you pause, check volatility, and avoid entering without a plan.',
    cta: 'View Mira package',
  },
  {
    name: 'AXON',
    sub: 'BTC Bot',
    rows: [
      { k: 'Status', v: 'Ready', status: true },
      { k: 'Instrument', v: 'Bitcoin (BTC)' },
      { k: 'Monthly Average ROI', v: '5–7%', accent: true },
      { k: 'Price', v: '$4,000' },
      { k: 'Role', v: 'Momentum and risk monitor' },
    ],
    strategy: 'BTC movement, volatility, and momentum-context monitoring.',
    guardian: 'Helps you avoid reacting to fast crypto moves without clear structure.',
    cta: 'View Axon package',
  },
  {
    name: 'KAIRO',
    sub: 'USD/JPY Bot',
    rows: [
      { k: 'Status', v: 'Ready', status: true },
      { k: 'Instrument', v: 'USD/JPY' },
      { k: 'Monthly Average ROI', v: '4–6%', accent: true },
      { k: 'Price', v: '$5,000' },
      { k: 'Role', v: 'Timing monitor' },
    ],
    strategy: 'USD/JPY movement, trend pressure, and timing-context monitoring.',
    guardian: 'Helps you check whether the moment still fits the plan.',
    cta: 'View Kairo package',
  },
];

const relStats = [
  { v: '92%', k: 'Overall win rate' },
  { v: '1–2%', k: 'Overall drawdown' },
  { v: '548 days', k: 'Live + backtested operation' },
  { v: '4–5%', k: 'Monthly average ROI' },
];
---

<Layout title="Vectora — Bots" description="Vectora Bots: three AI bot profiles designed for private clients who want clearer risk context and more disciplined timing across concrete instruments.">
  <section class="section page-hero">
    <div class="container">
      <h1 class="reveal">Vectora <span class="grad-text">Bots</span></h1>
      <p class="lede reveal" style="--reveal-delay:140ms">
        Three AI bot profiles designed for private clients who want clearer
        risk context and more disciplined timing across concrete instruments.
      </p>

      <div class="badges reveal" style="--reveal-delay:200ms">
        {badges.map((b) => <span class="badge">{b}</span>)}
      </div>

      <ul class="hero-stats reveal" style="--reveal-delay:260ms">
        {heroStats.map((s) => (
          <li><span class="num figure">{s.v}</span><span class="k figure-label">{s.k}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bots-sec">
    <div class="container">
      <div class="bot-grid">
        {bots.map((b, i) => (
          <article class="bot card hoverable spot reveal" style={`--reveal-delay:${i * 90}ms`}>
            <div class="b-head">
              <h2>{b.name}</h2>
              <span class="b-sub">{b.sub}</span>
            </div>

            <dl class="b-rows">
              {b.rows.map((r) => (
                <div>
                  <dt>{r.k}</dt>
                  <dd class={r.accent ? 'accent' : ''}>
                    {r.status && <span class="s-dot" aria-hidden="true"></span>}{r.v}
                  </dd>
                </div>
              ))}
            </dl>

            <div class="b-block">
              <span class="b-label">Strategy</span>
              <p>{b.strategy}</p>
            </div>
            <div class="b-block">
              <span class="b-label">Guardian role</span>
              <p>{b.guardian}</p>
            </div>

            <a href="/packages" class="btn btn-outline b-cta">{b.cta} <span class="arrow" aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section testing">
    <div class="container">
      <div class="section-head reveal">
        <h2>Capital discipline, <span class="grad-text">before anything else</span></h2>
        <p>
          Vectora is built to sit between the client and the market as a
          guardian layer. It monitors selected conditions, checks risk
          context, and helps keep decisions structured.
        </p>
      </div>

      <div class="test-stats reveal" style="--reveal-delay:120ms">
        {relStats.map((s) => (
          <div class="ts-tile card spot"><span class="ts-k figure-label">{s.k}</span><span class="ts-v figure">{s.v}</span></div>
        ))}
      </div>
    </div>
  </section>

  <ClosingCta
    title='Deploy a bot <span class="grad-text">with guidance</span>'
    body="Choose your instrument, speak with our team, and prepare your account through one of our supported brokers. Packages are coming soon."
    primary={{ label: 'View packages →', href: '/packages' }}
    secondary={{ label: 'Talk to our team', href: '/support' }}
  />
</Layout>

<style>
  .badges { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.7rem; margin-top: 1.75rem; }
  .badge {
    font-family: var(--font-mono); font-size: 0.7rem; font-weight: 500;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--green-bright); background: var(--green-tint);
    border: 1px solid rgba(23, 212, 139, 0.25);
    padding: 0.4rem 0.8rem; border-radius: 4px;
  }

  .hero-stats {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;
    margin-top: 2.5rem; padding-top: 1.75rem; border-top: 1px solid var(--line);
    text-align: center;
  }
  .hero-stats .num { display: block; font-size: clamp(1.5rem, 3vw, 2.1rem); color: var(--green-bright); }
  .hero-stats .k { display: block; margin-top: 0.3rem; }

  .bots-sec { padding-top: clamp(1rem, 3vw, 2rem); }
  .bot-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .bot { display: flex; flex-direction: column; }
  .b-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .bot h2 { font-size: 1.6rem; }
  .b-sub { font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-3); letter-spacing: 0.06em; text-transform: uppercase; }

  .b-rows { display: grid; margin-top: 1.1rem; border-top: 1px solid var(--line); }
  .b-rows > div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.6rem 0; border-bottom: 1px solid var(--line); }
  .b-rows dt { color: var(--text-3); font-size: 0.84rem; }
  .b-rows dd { font-family: var(--font-display); font-weight: 600; font-size: 0.88rem; color: var(--text); text-align: right; display: inline-flex; align-items: center; gap: 0.4rem; }
  .b-rows dd.accent { color: var(--green-bright); }
  .s-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--green-bright); animation: bpulse 1.8s infinite; }
  @keyframes bpulse { 0% { box-shadow: 0 0 0 0 rgba(23, 212, 139, 0.5); } 100% { box-shadow: 0 0 0 7px rgba(23, 212, 139, 0); } }

  .b-block { margin-top: 1rem; }
  .b-label { font-family: var(--font-mono); font-size: 0.66rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--green-bright); }
  .b-block p { color: var(--text-3); font-size: 0.9rem; margin-top: 0.35rem; }
  .b-block:last-of-type { flex: 1; }

  .b-cta { width: 100%; margin-top: 1.4rem; }

  .testing { background: var(--bg-2); border-block: 1px solid var(--line); }
  .test-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .ts-tile { padding: 1.5rem; text-align: center; }
  .ts-k { display: block; }
  .ts-v { display: block; font-size: 2rem; margin-top: 0.45rem; color: var(--green-bright); }

  @media (max-width: 900px) {
    .bot-grid { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; }
    .test-stats { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .hero-stats { grid-template-columns: repeat(2, 1fr); gap: 1.5rem 1rem; }
  }
  @media (max-width: 420px) { .test-stats { grid-template-columns: 1fr; } }
</style>
