---
import Layout from '../layouts/Layout.astro';
import Strategy from '../components/Strategy.astro';

const principles = [
  {
    title: 'Rules-based execution',
    body: 'Every entry, position size and exit follows predefined logic — no emotion, no improvisation, the same way every session.',
    icon: 'rules',
  },
  {
    title: 'Risk controls first',
    body: 'Per-trade stops, daily loss limits and maximum-drawdown caps that you set and the engine enforces automatically.',
    icon: 'shield',
  },
  {
    title: 'Backtested & forward-tested',
    body: 'Strategies are validated across historical data and proven on a live demo account before they touch real capital.',
    icon: 'chart',
  },
  {
    title: 'Fully transparent',
    body: 'Watch every order, fill and the logic behind it in real time — no black boxes, no hidden behaviour.',
    icon: 'eye',
  },
];

const icons: Record<string, string> = {
  rules: '<path d="M9 6h11M9 12h11M9 18h11"/><path d="M4 5.5l1 1 2-2M4 11.5l1 1 2-2M4 17.5l1 1 2-2"/>',
  shield: '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/><path d="M9.5 12l1.8 1.8L15 10"/>',
  chart: '<path d="M4 19V5M4 19h16M8 16v-5M12 16V8M16 16v-3"/>',
  eye: '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>',
};
---

<Layout title="Vectora — Strategy" description="How Vectora executes your strategy: rules-based, risk-first and fully transparent. Connect, configure, activate.">
  <section class="section page-hero">
    <div class="container">
      <span class="eyebrow reveal"><span class="dot"></span> Strategy</span>
      <h1 class="reveal" style="--reveal-delay:80ms">Execution you can <span class="text-accent">see</span>.</h1>
      <p class="lede reveal" style="--reveal-delay:140ms">
        No black boxes. Vectora turns a disciplined trading process into a workflow
        you can set up in an afternoon — with risk control enforced at every step.
      </p>
    </div>
  </section>

  <Strategy />

  <section class="section principles">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Principles</span>
        <h2>Built on <span class="text-accent">discipline</span></h2>
        <p>The edge in trading is rarely the idea — it's executing it flawlessly, every time. That's what the engine is for.</p>
      </div>

      <div class="pr-grid">
        {principles.map((p, i) => (
          <article class="card pr reveal" style={`--reveal-delay:${i * 70}ms`}>
            <span class="pr-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[p.icon]} />
            </span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section cta-sec">
    <div class="container cta reveal">
      <h2>Put your strategy <span class="text-accent">on autopilot</span></h2>
      <p>Pick a package or talk to our team about a setup that fits how you trade.</p>
      <div class="cta-actions">
        <a href="/packages" class="btn btn-primary btn-lg">View packages <span class="arrow" aria-hidden="true">→</span></a>
        <a href="/support" class="btn btn-ghost btn-lg">Talk to our team</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero { padding-block: clamp(2.5rem, 6vw, 4rem) clamp(0.5rem, 2vw, 1rem); }
  .page-hero h1 { font-size: clamp(2.6rem, 6vw, 4.2rem); font-weight: 800; margin-top: 1.2rem; }
  .lede { color: var(--c-text-muted); font-size: 1.1rem; max-width: 58ch; margin-top: 1.2rem; }

  .pr-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }
  .pr { display: flex; flex-direction: column; }
  .pr-icon {
    display: inline-flex; width: 46px; height: 46px;
    align-items: center; justify-content: center; border-radius: 12px;
    margin-bottom: 1.1rem; color: var(--c-accent-bright);
    background: var(--c-accent-soft); border: 1px solid var(--glass-border);
  }
  .pr-icon svg { width: 23px; height: 23px; }
  .pr h3 { font-size: 1.12rem; margin-bottom: 0.5rem; }
  .pr p { color: var(--c-text-muted); font-size: 0.93rem; }

  .cta { text-align: center; max-width: 660px; margin-inline: auto; padding: clamp(2rem, 5vw, 3.5rem); background: var(--grad-soft); border: 1px solid var(--glass-border); border-radius: var(--radius-lg); }
  .cta h2 { font-size: clamp(1.8rem, 4vw, 2.6rem); }
  .cta p { color: var(--c-text-muted); margin-top: 0.8rem; }
  .cta-actions { display: flex; gap: 0.85rem; justify-content: center; flex-wrap: wrap; margin-top: 1.8rem; }

  @media (max-width: 900px) { .pr-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .pr-grid { grid-template-columns: 1fr; } }
</style>
