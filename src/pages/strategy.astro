---
import Layout from '../layouts/Layout.astro';
import HowItWorks from '../components/HowItWorks.astro';
import TrialCta from '../components/TrialCta.astro';

const principles = [
  {
    title: 'Rules-based execution',
    body: 'Every entry, position size and exit follows predefined logic — no emotion, no improvisation, the same way every session.',
    icon: 'rules',
  },
  {
    title: 'Risk controls first',
    body: 'Per-trade stops and drawdown caps are enforced automatically. Across all bots, drawdown has stayed within 1–2%.',
    icon: 'shield',
  },
  {
    title: 'Backtested & forward-tested',
    body: 'Strategies are validated across 1.5 years of historical data and proven in live conditions before they touch client capital.',
    icon: 'chart',
  },
  {
    title: 'Fully transparent',
    body: 'Watch every order, fill and the logic behind it in real time — no black boxes, no hidden behaviour.',
    icon: 'eye',
  },
];

const icons: Record<string, string> = {
  rules: '<path d="M9 6h11M9 12h11M9 18h11"/><path d="M4 5.5l1 1 2-2M4 11.5l1 1 2-2M4 17.5l1 1 2-2"/>',
  shield: '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/><path d="M9.5 12l1.8 1.8L15 10"/>',
  chart: '<path d="M4 19V5M4 19h16M8 16v-5M12 16V8M16 16v-3"/>',
  eye: '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>',
};
---

<Layout title="Vectora — Strategy" description="How Vectora executes: rules-based, risk-first and fully transparent, on three markets only. Connect, configure, activate.">
  <section class="section page-hero">
    <div class="container">
      <h1 class="reveal">Execution you can <span class="grad-text">see.</span></h1>
      <p class="lede reveal" style="--reveal-delay:120ms">
        No black boxes. Vectora turns a disciplined trading process into a
        workflow you can set up in an afternoon — with risk control enforced
        at every step, on three markets we know deeply.
      </p>
    </div>
  </section>

  <HowItWorks />

  <section class="section principles">
    <div class="container">
      <div class="section-head reveal">
        <h2>Built on <span class="grad-text">discipline</span></h2>
        <p>The edge in trading is rarely the idea — it's executing it flawlessly, every time. That's what the engine is for.</p>
      </div>

      <div class="pr-grid">
        {principles.map((p, i) => (
          <article class="card hoverable spot pr reveal" style={`--reveal-delay:${i * 70}ms`}>
            <span class="pr-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[p.icon]} />
            </span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <TrialCta />
</Layout>

<style>
  .pr-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }
  .pr { display: flex; flex-direction: column; }
  .pr-icon {
    display: inline-flex; width: 44px; height: 44px;
    align-items: center; justify-content: center; border-radius: var(--radius-sm);
    margin-bottom: 1.1rem; color: var(--green-bright);
    background: var(--green-tint); border: 1px solid rgba(23, 212, 139, 0.22);
  }
  .pr-icon svg { width: 22px; height: 22px; }
  .pr h3 { font-size: 1.12rem; margin-bottom: 0.5rem; }
  .pr p { color: var(--text-3); font-size: 0.93rem; }

  @media (max-width: 900px) { .pr-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .pr-grid { grid-template-columns: 1fr; } }
</style>
