---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Vectora — Page not found" description="This page doesn't exist.">
  <section class="section nf">
    <div class="container nf-inner">
      <span class="nf-code figure">404</span>
      <h1>Page not found</h1>
      <p class="lede">The page you're looking for doesn't exist or has moved.</p>
      <div class="nf-actions">
        <a href="/" class="btn btn-primary btn-lg">Back to home <span class="arrow" aria-hidden="true">→</span></a>
        <a href="/support" class="btn btn-outline btn-lg">Talk to our team</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .nf { min-height: calc(100vh - var(--header-h) - 320px); display: grid; align-items: center; }
  .nf-inner { text-align: center; display: flex; flex-direction: column; align-items: center; }
  .nf-code {
    font-size: clamp(4rem, 12vw, 7rem);
    line-height: 1;
    background: var(--grad-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .nf h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin-top: 1rem; }
  .lede { color: var(--text-3); margin-top: 0.9rem; }
  .nf-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.85rem; margin-top: 2rem; }
</style>
